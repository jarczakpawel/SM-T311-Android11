diff --git a/src/gbm/Android.mk b/src/gbm/Android.mk
index b8217163c1100186d214241f8e3aa23e6c726008..8a37fd08cd521e37dc61a37cc1d2c7312d215167 100644
--- a/src/gbm/Android.mk
+++ b/src/gbm/Android.mk
@@ -32,18 +32,43 @@ LOCAL_EXPORT_C_INCLUDE_DIRS := \
 LOCAL_C_INCLUDES := \
 	$(LOCAL_PATH)/main
 
-LOCAL_STATIC_LIBRARIES := \
-	libmesa_util \
-	libmesa_loader
-
 LOCAL_MODULE := libgbm_mesa
 LOCAL_LICENSE_KINDS := SPDX-license-identifier-MIT
 LOCAL_LICENSE_CONDITIONS := notice
 LOCAL_NOTICE_FILE := $(LOCAL_PATH)/../../LICENSE
 
-LOCAL_SRC_FILES := \
-	$(gbm_core_FILES) \
-	$(gbm_dri_FILES)
-
+# G867: SM-T311 must install the same 26.2.5 GBM as the five pinned
+# PRODUCT_COPY_FILES GLES/Gallium/DRM libraries. Defining this as the
+# libgbm_mesa prebuilt module, rather than a second copy-file recipe,
+# prevents two producers of vendor/lib/libgbm_mesa.so under Kati.
+# Keep the original source-compiled module on every other target/rollback.
+ifeq ($(TARGET_DEVICE),lt013g)
+ifeq ($(SMT311_USE_MESA26),true)
+ifeq ($(SMT311_MESA26_VERSION),26.2.5)
+LOCAL_SRC_FILES := ../../../../device/samsung/lt01-common/prebuilt/pjarczak/mesa26-2625/libgbm_mesa.so
+LOCAL_MODULE_CLASS := SHARED_LIBRARIES
+LOCAL_MODULE_SUFFIX := .so
+LOCAL_STRIP_MODULE := false
+LOCAL_VENDOR_MODULE := true
+LOCAL_SHARED_LIBRARIES := libdrm_mesa26 liblog
+# Android11's Make exports BUILD_PREBUILT, NOT PREBUILT_SHARED_LIBRARY;
+# the latter silently expands to an empty include and omits GBM entirely.
+include $(BUILD_PREBUILT)
+else
+LOCAL_STATIC_LIBRARIES := libmesa_util libmesa_loader
+LOCAL_SRC_FILES := $(gbm_core_FILES) $(gbm_dri_FILES)
+include $(MESA_COMMON_MK)
+include $(BUILD_SHARED_LIBRARY)
+endif
+else
+LOCAL_STATIC_LIBRARIES := libmesa_util libmesa_loader
+LOCAL_SRC_FILES := $(gbm_core_FILES) $(gbm_dri_FILES)
+include $(MESA_COMMON_MK)
+include $(BUILD_SHARED_LIBRARY)
+endif
+else
+LOCAL_STATIC_LIBRARIES := libmesa_util libmesa_loader
+LOCAL_SRC_FILES := $(gbm_core_FILES) $(gbm_dri_FILES)
 include $(MESA_COMMON_MK)
 include $(BUILD_SHARED_LIBRARY)
+endif
