diff --git a/tools/t311_verify_local_seek.py b/tools/t311_verify_local_seek.py
new file mode 100644
index 0000000000000000000000000000000000000000..b1fcabbd1953d3fcf6bb819d0d1ff62de1397bf2
--- /dev/null
+++ b/tools/t311_verify_local_seek.py
@@ -0,0 +1,27 @@
+#!/usr/bin/env python3
+"""SM-T311 Gallery seek regression check; source-only, never touches device."""
+from pathlib import Path
+
+root = Path(__file__).resolve().parents[1]
+base = root / 'src/com/android/gallery3d/app'
+movie = (base / 'MoviePlayer.java').read_text()
+gesture = (base / 'GestureControllerOverlay.java').read_text()
+video = (root / 'src/org/codeaurora/gallery3d/video/CodeauroraVideoView.java').read_text()
+timebar = (base / 'TimeBar.java').read_text()
+
+assert 'private boolean canSeekLocalRecording()' in movie
+assert 'MediaPlayer.SEEK_CLOSEST' in movie
+assert 'G891_SEEK_REQUEST' in movie and 'G891_SEEK_COMPLETE' in movie
+assert 'mVideoView.setOnSeekCompleteListener(this);' in movie
+assert 'mMediaPlayer.setOnSeekCompleteListener(mOnSeekCompleteListener);' in video
+assert 'public void setOnSeekCompleteListener(MediaPlayer.OnSeekCompleteListener l)' in video
+assert 'mListener.onScrubbingEnd(getScrubberTime(), 0, 0);' in timebar
+start = gesture.split('public void adjustVideoPosition(double adjustPercent, boolean forwardDirection) {', 1)[1]
+end = start.split('\n    @Override', 1)[0]
+assert 'mPendingSeekTime = targetTime;' in end
+assert 'mListener.onSeekEnd(' not in end, 'G892 old per-MOVE seek flood returned'
+done = gesture.split('public void onGestureDone(boolean notStart) {', 1)[1].split('\n    @Override', 1)[0]
+assert done.count('mListener.onSeekEnd(mPendingSeekTime, 0, 0);') == 1
+assert 'mPendingSeekTime = -1;' in done
+assert 'mListener.onSeekStart();' in end
+print('G892_GALLERY_LOCAL_SEEK_SCRUB_CALLBACKS_AND_ONE_GESTURE_ONE_MEDIA_SEEK_SOURCE_PASS')
