+	nreq  |= (unsigned long long)req[1] << 16;
+	nreq  |= (unsigned long long)req[2];
+	nhost |= (unsigned long long)v[0]   << 32;
+	nhost |= (unsigned long long)v[1]   << 16;
+	nhost |= (unsigned long long)v[2];
+
+	return nreq > nhost ? 1 : 0;
