+static int set_guid(__u8 *guid, const char *input)
+{
+	__u8 buf[EXFAT_GUID_LEN];
+	int i, j, zero_len = 0;
+	int len = strlen(input);
+
+	if (len != EXFAT_GUID_LEN * 2 && len != EXFAT_GUID_LEN * 2 + 4) {
+		exfat_err("invalid format for volume guid\n");
+		return -EINVAL;
+	}
+
+	for (i = 0, j = 0; i < len; i++) {
+		unsigned char ch = input[i];
+
+		if (ch >= '0' && ch <= '9')
+			ch -= '0';
+		else if (ch >= 'a' && ch <= 'f')
+			ch -= 'a' - 0xA;
+		else if (ch >= 'A' && ch <= 'F')
+			ch -= 'A' - 0xA;
+		else if (ch == '-' && len == EXFAT_GUID_LEN * 2 + 4 &&
+			 (i == 8 || i == 13 || i == 18 || i == 23))
+			continue;
+		else {
+			exfat_err("invalid character '%c' for volume GUID\n", ch);
+			return -EINVAL;
+		}
+
+		if (j & 1)
+			buf[j >> 1] |= ch;
+		else
+			buf[j >> 1] = ch << 4;
+
+		j++;
+
+		if (ch == 0)
+			zero_len++;
+	}
+
+	if (zero_len == EXFAT_GUID_LEN * 2) {
+		exfat_err("%s is invalid for volume GUID\n", input);
+		return -EINVAL;
+	}
+
+	guid[0] = buf[3];
+	guid[1] = buf[2];
+	guid[2] = buf[1];
+	guid[3] = buf[0];
+
+	guid[4] = buf[5];
+	guid[5] = buf[4];
+
+	guid[6] = buf[7];
+	guid[7] = buf[6];
+
+	guid[8] = buf[8];
+	guid[9] = buf[9];
+
+	guid[10] = buf[10];
+	guid[11] = buf[11];
+	guid[12] = buf[12];
+	guid[13] = buf[13];
+	guid[14] = buf[14];
+	guid[15] = buf[15];
+
