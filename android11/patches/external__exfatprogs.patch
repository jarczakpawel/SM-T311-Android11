+static void exfat_free_inode_chain(struct exfat_inode *inode)
+{
+	struct exfat_inode *parent;
+
+	while (inode) {
+		parent = inode->parent;
+		exfat_free_inode(inode);
+		inode = parent;
+	}
+}
