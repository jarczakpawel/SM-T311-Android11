+
+int exfat_unmap_mm(const void *m, const size_t len, bool *mapped)
+{
+	if (m == NULL)
+		return 0;
+
+#ifdef _POSIX_MAPPED_FILES
+	if (*mapped) {
+		*mapped = false;
+		if (len > 0)
+			return munmap((void *)m, len);
+		return 0;
+	}
+#else
+	(void)mapped;
+#endif
+	free((void *)m);
+	(void)len;
+
+	return 0;
+}
