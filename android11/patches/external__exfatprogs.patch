+		rnd.n.b ^= (uint64_t)getpgrp() * A + C;
+		rnd.n.a ^= (uint64_t)ts[0].tv_sec * A + C;
+		rnd.n.a ^= (uint64_t)ts[0].tv_nsec * A + C;
+		rnd.n.b ^= (uint64_t)ts[1].tv_sec * A + C;
+		rnd.n.b ^= (uint64_t)ts[1].tv_nsec * A + C;
