+/*
+ * SM-T311/XMM6262 compatibility: the modem releases a single CS call on the
+ * network immediately, but Samsung's proprietary RIL can hold the solicited
+ * RIL_REQUEST_HANGUP completion for ~60 seconds. Android 11 waits for that
+ * solicited completion before it polls GET_CURRENT_CALLS, leaving InCall UI
+ * stuck in DISCONNECTING although the remote side is already gone.
+ *
+ * Keep the real vendor request/token alive. For the narrow, proven-safe case
+ * of exactly one last-known call whose GSM index matches the requested hangup,
+ * acknowledge HANGUP to HIDL immediately and satisfy the *next* framework
+ * GET_CURRENT_CALLS locally with an empty list. The late vendor completion is
+ * swallowed at the HIDL boundary only; libril still dequeues/frees its real
+ * RequestInfo in RIL_onRequestComplete(). Multi-call/call-waiting states never
+ * enter this path.
+ */
+static const char t311_v199_hangup_compat_canary[] __attribute__((used)) =
+        "T311_V199_OPTIMISTIC_SINGLE_CALL_HANGUP_57C1D84E";
+
+struct T311V199HangupCompatState {
+    int lastCallCount;
+    int lastSingleCallIndex;
+    bool emptyPollPending;
+    int syntheticHangupSerial;
+    int64_t armedMs;
+};
+
+static pthread_mutex_t t311_v199_hangup_mutex = PTHREAD_MUTEX_INITIALIZER;
+static T311V199HangupCompatState t311_v199_hangup_state[4] = {
+    {-1, -1, false, -1, 0},
+    {-1, -1, false, -1, 0},
+    {-1, -1, false, -1, 0},
+    {-1, -1, false, -1, 0},
+};
+
+static int t311_v199_slot(int slotId) {
+    return (slotId >= 0 && slotId < 4) ? slotId : 0;
+}
+
+static bool t311_v199_enabled() {
+    char device[PROPERTY_VALUE_MAX] = {};
+    property_get("ro.product.device", device, "");
+    return strcmp(device, "lt013g") == 0;
+}
+
+static void t311_v199_note_call_list(int slotId, int count, int singleIndex) {
+    if (!t311_v199_enabled()) return;
+    const int slot = t311_v199_slot(slotId);
+    pthread_mutex_lock(&t311_v199_hangup_mutex);
+    t311_v199_hangup_state[slot].lastCallCount = count;
+    t311_v199_hangup_state[slot].lastSingleCallIndex = (count == 1) ? singleIndex : -1;
+    pthread_mutex_unlock(&t311_v199_hangup_mutex);
+    RLOGD("T311_V199 CALL_LIST note slot=%d count=%d single_index=%d",
+            slot, count, (count == 1) ? singleIndex : -1);
+}
+
+static bool t311_v199_arm_single_hangup(int slotId, int serial, int gsmIndex) {
+    if (!t311_v199_enabled()) return false;
+    const int slot = t311_v199_slot(slotId);
+    bool eligible = false;
+    pthread_mutex_lock(&t311_v199_hangup_mutex);
+    T311V199HangupCompatState &st = t311_v199_hangup_state[slot];
+    if (st.lastCallCount == 1 && st.lastSingleCallIndex == gsmIndex) {
+        st.emptyPollPending = true;
+        st.syntheticHangupSerial = serial;
+        st.armedMs = android::elapsedRealtime();
+        eligible = true;
+    }
+    pthread_mutex_unlock(&t311_v199_hangup_mutex);
+    if (eligible) {
+        RLOGI("T311_V199 HANGUP arm slot=%d serial=%d gsm_index=%d mode=single-call",
+                slot, serial, gsmIndex);
+    } else {
+        RLOGI("T311_V199 HANGUP bypass slot=%d serial=%d gsm_index=%d reason=not-single-known-call",
+                slot, serial, gsmIndex);
+    }
+    return eligible;
+}
+
+static void t311_v199_cancel_arm(int slotId, int serial, const char *reason) {
+    if (!t311_v199_enabled()) return;
+    const int slot = t311_v199_slot(slotId);
+    pthread_mutex_lock(&t311_v199_hangup_mutex);
+    T311V199HangupCompatState &st = t311_v199_hangup_state[slot];
+    if (st.syntheticHangupSerial == serial) {
+        st.emptyPollPending = false;
+        st.syntheticHangupSerial = -1;
+        st.armedMs = 0;
+    }
+    pthread_mutex_unlock(&t311_v199_hangup_mutex);
+    RLOGW("T311_V199 HANGUP arm-cancel slot=%d serial=%d reason=%s",
+            slot, serial, reason ? reason : "unknown");
+}
+
+static bool t311_v199_consume_empty_poll(int slotId, int *hangupSerial, int64_t *ageMs) {
+    if (!t311_v199_enabled()) return false;
+    const int slot = t311_v199_slot(slotId);
+    const int64_t now = android::elapsedRealtime();
+    bool synth = false;
+    int origin = -1;
+    int64_t age = -1;
+    pthread_mutex_lock(&t311_v199_hangup_mutex);
+    T311V199HangupCompatState &st = t311_v199_hangup_state[slot];
+    if (st.emptyPollPending) {
+        age = now - st.armedMs;
+        if (age >= 0 && age <= 5000) {
+            synth = true;
+            origin = st.syntheticHangupSerial;
+            st.emptyPollPending = false;
+            st.lastCallCount = 0;
+            st.lastSingleCallIndex = -1;
+        } else {
+            st.emptyPollPending = false;
+            RLOGW("T311_V199 GET_CURRENT_CALLS optimistic window expired slot=%d age_ms=%" PRId64,
+                    slot, age);
+        }
+    }
+    pthread_mutex_unlock(&t311_v199_hangup_mutex);
+    if (hangupSerial) *hangupSerial = origin;
+    if (ageMs) *ageMs = age;
+    return synth;
+}
+
+static bool t311_v199_swallow_late_hangup(int slotId, int serial, RIL_Errno e) {
+    if (!t311_v199_enabled()) return false;
+    const int slot = t311_v199_slot(slotId);
+    bool swallow = false;
+    pthread_mutex_lock(&t311_v199_hangup_mutex);
+    T311V199HangupCompatState &st = t311_v199_hangup_state[slot];
+    if (st.syntheticHangupSerial == serial) {
+        swallow = true;
+        st.syntheticHangupSerial = -1;
+        st.emptyPollPending = false;
+        st.armedMs = 0;
+    }
+    pthread_mutex_unlock(&t311_v199_hangup_mutex);
+    if (swallow) {
+        RLOGI("T311_V199 HANGUP late-vendor-response swallowed slot=%d serial=%d errno=%d",
+                slot, serial, (int)e);
+    }
+    return swallow;
+}
