+#ifdef MODEM_TYPE_XMM6262
+/*
+ * Samsung legacy RIL ABI used by the SM-T311/XMM6262 blob.
+ * Standard Android 11 RIL_AppStatus is 32 bytes on ARM32.
+ * Samsung appends five 32-bit private fields (PIN1/PUK1/PIN2/PUK2
+ * retry counts plus personalization-unblock retries), making each app entry 52 bytes.
+ *
+ * CardStatus is otherwise v6:
+ * 24-byte header + 8 * 52-byte app entries = 440 bytes.
+ */
+struct T311SamsungRILAppStatus {
+    RIL_AppType app_type;
+    RIL_AppState app_state;
+    RIL_PersoSubstate perso_substate;
+    char *aid_ptr;
+    char *app_label_ptr;
+    int pin1_replaced;
+    RIL_PinState pin1;
+    RIL_PinState pin2;
+    /* Samsung extended SIM retry counters appended to AOSP RIL_AppStatus. */
+    int pin1_num_retries;
+    int puk1_num_retries;
+    int pin2_num_retries;
+    int puk2_num_retries;
+    int perso_unblock_retries;
+};
+
+struct T311SamsungRILCardStatusV6 {
+    RIL_CardState card_state;
+    RIL_PinState universal_pin_state;
+    int gsm_umts_subscription_app_index;
+    int cdma_subscription_app_index;
+    int ims_subscription_app_index;
+    int num_applications;
+    T311SamsungRILAppStatus applications[RIL_CARD_MAX_APPS];
+};
+
+static_assert(sizeof(T311SamsungRILAppStatus) == 52,
+        "T311 Samsung RIL_AppStatus ARM32 ABI must be 52 bytes");
+static_assert(sizeof(T311SamsungRILCardStatusV6) == 440,
+        "T311 Samsung RIL_CardStatus_v6 ARM32 ABI must be 440 bytes");
+#endif
