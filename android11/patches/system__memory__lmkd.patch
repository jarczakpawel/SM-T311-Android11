diff --git a/tests/test_g1422_kernel7_workingset_refault_compat.py b/tests/test_g1422_kernel7_workingset_refault_compat.py
new file mode 100644
index 0000000000000000000000000000000000000000..d77d5f165429ab5d4abd1b1b4ae4269c4f9be3c9
--- /dev/null
+++ b/tests/test_g1422_kernel7_workingset_refault_compat.py
@@ -0,0 +1,63 @@
+#!/usr/bin/env python3
+"""G1422 production source regression for Linux >=5.9 / Android11 lmkd.
+
+No device writes or SIGKILLs. Source-shape verification plus fixture
+compatibility for both historic kernel and the real new vmstat/zoneinfo
+format. A native ARM32 lmkd link is additionally required for release.
+"""
+from pathlib import Path
+import re
+
+src=(Path(__file__).resolve().parents[1]/"lmkd.cpp").read_text()
+vm_array=re.search(r"static const char\* const vmstat_field_names\[VS_FIELD_COUNT\] = \{(.*?)\};",src,re.S)
+assert vm_array
+keys=re.findall(r'"([a-z_]+)"',vm_array.group(1))
+assert keys==[
+  "nr_free_pages","nr_inactive_file","nr_active_file",
+  "workingset_refault","workingset_refault_file",
+  "pgscan_kswapd","pgscan_direct","pgscan_direct_throttle"],keys
+zone_array=re.search(r"static const char\* const zoneinfo_node_field_names\[ZI_NODE_FIELD_COUNT\] = \{(.*?)\};",src,re.S)
+assert zone_array
+zones=re.findall(r'"([a-z_]+)"',zone_array.group(1))
+assert zones==["nr_inactive_file","nr_active_file"],zones
+assert "total_workingset_refault" not in src
+assert "static bool initialized;" in src
+assert "if (!initialized || killing)" in src
+assert "initialized = true;" in src
+assert "prev_workingset_refault = workingset_refault_file;" in src
+assert "VS_WORKINGSET_REFAULT_FILE" in src
+assert "int64_t workingset_refault_file;" in src
+func=src.split("static void mp_event_psi(",1)[1].split("static void mp_event_common(",1)[0]
+assert "vs.field.workingset_refault\n" in func
+assert "? vs.field.workingset_refault\n" in func
+assert ": vs.field.workingset_refault_file;" in func
+assert func.count("vs.field.workingset_refault")==3
+for needle in (
+ "init_ws_refault = workingset_refault_file;",
+ "prev_workingset_refault = workingset_refault_file;",
+ "workingset_refault_file == prev_workingset_refault",
+ "thrashing = (workingset_refault_file - init_ws_refault)",
+ "prev_thrash_growth = (workingset_refault_file - init_ws_refault)",
+):
+ assert needle in func,needle
+
+def parse(lines,names):
+ vals={k:0 for k in names}
+ for line in lines.strip().splitlines():
+  name,value=line.split()
+  if name in vals: vals[name]=int(value)
+ return vals
+
+for name,vm,zone in (
+ ("legacy_4_19", "nr_free_pages 10000\nnr_inactive_file 1200\nnr_active_file 100\nworkingset_refault 747\npgscan_direct 0\n", "nr_inactive_file 1200\nnr_active_file 100\nworkingset_refault 747\n"),
+ ("modern_7_3", "nr_free_pages 10000\nnr_inactive_file 157189\nnr_active_file 61\nworkingset_refault_anon 0\nworkingset_refault_file 7552\npgscan_direct 0\n", "nr_inactive_file 157189\nnr_active_file 61\nworkingset_refault_file 7552\n"),
+):
+ v=parse(vm,keys)
+ z=parse(zone,zones)
+ assert len(z)==2 and all(field in z for field in zones)
+ refault=v["workingset_refault"] or v["workingset_refault_file"]
+ assert refault==({"legacy_4_19":747,"modern_7_3":7552}[name])
+ assert refault>0
+ print("G1422_"+name.upper()+"_PARSE_REFCOUNT_PASS",refault)
+
+print("G1422_LMKD_KERNEL7_PLUS_OLD_KERNEL_COMPAT_SOURCE_TEST_PASS")
