+/* Samsung SM-T311 stock libsec-ril.so still reports RIL_SignalStrength_v6.
+ * Its OEM NetworkRespBuilder emits exactly 48 bytes (12 x int32).  Android
+ * 11's HIDL adapter previously rejected both unsolicited and queried values,
+ * then produced INVALID_RESPONSE, despite a valid modem measurement.
+ * Expand in a separate local V8 structure so no out-of-bounds field reads and
+ * the shared existing LTE sentinel conversion remains authoritative.
+ */
+void convertRilSignalStrengthToHalV6(const RIL_SignalStrength_v6 *legacy,
+        SignalStrength& signalStrength) {
+    RIL_SignalStrength_v8 expanded = {};
+    expanded.GW_SignalStrength = legacy->GW_SignalStrength;
+    expanded.CDMA_SignalStrength = legacy->CDMA_SignalStrength;
+    expanded.EVDO_SignalStrength = legacy->EVDO_SignalStrength;
+    expanded.LTE_SignalStrength.signalStrength = legacy->LTE_SignalStrength.signalStrength;
+    expanded.LTE_SignalStrength.rsrp = legacy->LTE_SignalStrength.rsrp;
+    expanded.LTE_SignalStrength.rsrq = legacy->LTE_SignalStrength.rsrq;
+    expanded.LTE_SignalStrength.rssnr = legacy->LTE_SignalStrength.rssnr;
+    expanded.LTE_SignalStrength.cqi = legacy->LTE_SignalStrength.cqi;
+    expanded.LTE_SignalStrength.timingAdvance = INT_MAX;
+    convertRilSignalStrengthToHalV8(&expanded, sizeof(expanded), signalStrength);
+    signalStrength.gw.timingAdvance = INT_MAX;
+}
