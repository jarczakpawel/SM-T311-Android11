+// Samsung Pin/Puk/PinChange constructors copy 9 bytes per code and 39 per AID.
+// Reject empty or malformed credentials before reaching the proprietary RIL.
+enum class T311SimSecretResult { Ok, Invalid, NoMemory };
+
+static bool t311PadSimField(char **field, size_t minimumBytes) {
+    if (field == nullptr || *field == nullptr) return false;
+    size_t len = strlen(*field);
+    if (len + 1 >= minimumBytes) return true;
+    char *padded = static_cast<char *>(calloc(minimumBytes, 1));
+    if (padded == nullptr) return false;
+    memcpy(padded, *field, len);
+    memsetAndFreeStrings(1, *field);
+    *field = padded;
+    return true;
+}
+
+static T311SimSecretResult t311PrepareSimSecrets(int request, char **fields, int count) {
+    int secretCount;
+    int expectedCount;
+    bool isPuk;
+    switch (request) {
+        case RIL_REQUEST_ENTER_SIM_PIN:
+        case RIL_REQUEST_ENTER_SIM_PIN2:
+            secretCount = 1; expectedCount = 2; isPuk = false; break;
+        case RIL_REQUEST_ENTER_SIM_PUK:
+        case RIL_REQUEST_ENTER_SIM_PUK2:
+            secretCount = 2; expectedCount = 3; isPuk = true; break;
+        case RIL_REQUEST_CHANGE_SIM_PIN:
+        case RIL_REQUEST_CHANGE_SIM_PIN2:
+            secretCount = 2; expectedCount = 3; isPuk = false; break;
+        default:
+            return T311SimSecretResult::Ok;
+    }
+    if (count != expectedCount) return T311SimSecretResult::Invalid;
+    for (int i = 0; i < secretCount; ++i) {
+        if (fields[i] == nullptr) return T311SimSecretResult::Invalid;
+        size_t n = strnlen(fields[i], 9);
+        size_t min = (isPuk && i == 0) ? 8 : 4;
+        if (n < min || n > 8) return T311SimSecretResult::Invalid;
+        for (size_t j = 0; j < n; ++j) {
+            if (fields[i][j] < '0' || fields[i][j] > '9')
+                return T311SimSecretResult::Invalid;
+        }
+    }
+    for (int i = 0; i < expectedCount; ++i) {
+        if (!t311PadSimField(&fields[i], i == expectedCount - 1 ? 39 : 9))
+            return T311SimSecretResult::NoMemory;
+    }
+    return T311SimSecretResult::Ok;
+}
+// Fail closed on repeated numeric PIN/PUK attempts from a misbehaving framework.
+// Each request class may reach the OEM RIL only once per rild process lifetime;
+// no automatic unlock, no PIN/PUK guessing and no user secrets in the log.
+static std::atomic<unsigned char> t311SimCredentialOnce[6] = {};
+static bool t311ClaimSimCredentialAttempt(int request) {
+    int index;
+    switch (request) {
+        case RIL_REQUEST_ENTER_SIM_PIN: index = 0; break;
+        case RIL_REQUEST_ENTER_SIM_PIN2: index = 1; break;
+        case RIL_REQUEST_ENTER_SIM_PUK: index = 2; break;
+        case RIL_REQUEST_ENTER_SIM_PUK2: index = 3; break;
+        case RIL_REQUEST_CHANGE_SIM_PIN: index = 4; break;
+        case RIL_REQUEST_CHANGE_SIM_PIN2: index = 5; break;
+        default: return true;
+    }
+    unsigned char expected = 0;
+    return t311SimCredentialOnce[index].compare_exchange_strong(expected, 1,
+            std::memory_order_acq_rel, std::memory_order_relaxed);
+}
+#endif
