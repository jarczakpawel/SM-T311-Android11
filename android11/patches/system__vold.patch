diff --git a/tests/g737-exfat-ro-fallback.py b/tests/g737-exfat-ro-fallback.py
new file mode 100644
index 0000000000000000000000000000000000000000..32f9c03bbdceebc45a467674bc39094058c7cded
--- /dev/null
+++ b/tests/g737-exfat-ro-fallback.py
@@ -0,0 +1,94 @@
+#!/usr/bin/env python3
+"""G737 source/model regressions for non-destructive exFAT USB media handling.
+
+No partition writes, no flash or external storage access. Verify that:
+- clean exFAT gets regular RW-first mounting,
+- nonzero read-only fsck gets RO-only mount,
+- non-exFAT check failures remain fatal,
+- unknown benign entry sets are checksum and secondary-tag verified,
+- unknown critical entries still fail fsck, no auto-repair.
+"""
+from pathlib import Path
+A=Path(__file__).resolve().parents[3]
+vold=A/"system/vold"
+exfat=A/"external/exfatprogs"
+e=(vold/"fs/Exfat.cpp").read_text()
+h=(vold/"fs/Exfat.h").read_text()
+v=(vold/"model/PublicVolume.cpp").read_text()
+f=(exfat/"fsck/fsck.c").read_text()
+types=(exfat/"include/exfat_ondisk.h").read_text()
+checks={
+ "fsck_always_non_destructive":'cmd.push_back("-n");' in e and
+  'cmd.push_back("-a");' not in e,
+ "ro_flag_in_mount_signature":'bool forceReadOnly' in h and 'bool forceReadOnly)' in e,
+ "never_first_rw_on_bad_fsck":'if (!forceReadOnly) {' in e and
+   e.find('if (!forceReadOnly) {') < e.find('mount(source.c_str()'),
+ "always_RO_after_first_failed_RW":"mountFlags |= MS_RDONLY;" in e,
+ "exfat_failed_fsck_only_degrades_RO":'if (mFsType == "exfat")' in v and
+   "exfatReadOnly = true;" in v and
+   "ret = exfat::Mount(mDevPath" in v and
+   "exfatReadOnly);" in v,
+ "other_failed_checks_still_abort":'if (ret) {' in v and
+   '" failed filesystem check"' in v,
+ "benign_primary_explicit_filter":'IS_EXFAT_BENIGN_PRIMARY(dentry->type)' in f,
+ "benign_entries_verified_checksum":'dentry_calc_checksum(secondary, &checksum,' in f and
+  'checksum != expected_checksum' in f,
+ "secondary_flags_must_be_in_use":'EXFAT_DENTRY_SECONDARY)) !=' in f and
+   'EXFAT_DENTRY_IN_USE' in f,
+ "critical_unknown_still_fatal":'exfat_err("unknown entry type. 0x%x' in f and
+   'ret = -EINVAL;' in f,
+ "deleted_entry_handling_preserved":'IS_EXFAT_DELETED(dentry->type)' in f,
+ "only_benign_primary_type_mask":'(((x) & 0xE0) == 0xA0)' in types,
+}
+for name, good in checks.items():
+    assert good,name
+    print("PASS source",name)
+
+def entry_is_benign_primary(entry): return (entry & 0xE0)==0xA0
+def checksum(entries):
+    total=0
+    for i,block in enumerate(entries):
+        for offset,byte in enumerate(block):
+            if i==0 and offset in (2,3): continue
+            total=((total>>1)|((total & 1)<<15))
+            total=(total+byte)&0xffff
+    return total
+def valid_opaque_benign_primary(entries):
+    if not entries or len(entries[0])!=32:return False
+    primary=entries[0]
+    if not entry_is_benign_primary(primary[0]):return False
+    if len(entries)!=primary[1]+1:return False
+    if not all(len(x)==32 and x[0]&0xc0==0xc0 for x in entries[1:]):return False
+    return checksum(entries)==int.from_bytes(primary[2:4],"little")
+
+primary=bytearray(32);primary[0]=0xBA;primary[1]=1
+sec=bytearray(32);sec[0]=0xE0;sec[7]=0x55
+primary[2:4]=checksum([primary,sec]).to_bytes(2,"little")
+assert valid_opaque_benign_primary([primary,sec])
+print("PASS synthetic_valid_unknown_benign_set")
+for mutation in ("secondary_missing","secondary_critical","wrong_checksum","critical_primary","deleted_primary","wrong_count"):
+    p=bytearray(primary);q=bytearray(sec);items=[p,q]
+    if mutation=="secondary_missing":items=[p]
+    if mutation=="secondary_critical":q[0]=0x80
+    if mutation=="wrong_checksum":q[7]^=1
+    if mutation=="critical_primary":p[0]=0x8a
+    if mutation=="deleted_primary":p[0]=0x3a
+    if mutation=="wrong_count":p[1]=2
+    assert not valid_opaque_benign_primary(items),mutation
+    print("PASS synthetic_reject",mutation)
+
+def mount_mode(fs,check_ok):
+    if fs!="exfat":
+        return "NORMAL" if check_ok else "REJECT"
+    return "RW_FIRST_RO_FALLBACK" if check_ok else "RO_ONLY"
+cases=[
+ ("exfat",True,"RW_FIRST_RO_FALLBACK"),
+ ("exfat",False,"RO_ONLY"),
+ ("vfat",False,"REJECT"),
+ ("ntfs",False,"REJECT"),
+ ("ext4",False,"REJECT"),
+]
+for fs,ok,expected in cases:
+    assert mount_mode(fs,ok)==expected
+    print("PASS mount",fs,ok,expected)
+print("G737_SAFE_EXFAT_MODEL_PASS",len(checks)+7+len(cases))
