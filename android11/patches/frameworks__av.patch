@@ -0,0 +1,75 @@
+#!/usr/bin/env python3
+"""G1198: reject regressions of fixed screenrecord virtual projection.
+
+Static source gate on the EXACT source built for Android 11. Deliberately
+avoids running any screen recording, SurfaceFlinger, sound, or tablet actions.
+"""
+from pathlib import Path
+
+SOURCE = Path(__file__).resolve().parents[1] / "screenrecord.cpp"
+
+
+def verify(source: str) -> None:
+    require = (
+        "static bool gFixedOrientation = false;",
+        '{ "fixed-orientation",  no_argument,        NULL, \'L\' },',
+        "case 'L':\n            gFixedOrientation = true;\n            break;",
+        "if (!gFixedOrientation) { // G1198: avoid even querying rotation in fixed mode",
+        "Stops recorder projection updates but does NOT lock Android UI rotation.",
+    )
+    for token in require:
+        if source.count(token) != 1:
+            raise AssertionError("G1198_INVALID_OPTION_ORIENTATION_GUARD: " + repr(token))
+    method_start = source.index("static status_t runEncoder(")
+    method_end = source.index("static inline uint32_t floorToEven(", method_start)
+    method = source[method_start:method_end]
+    guarded = method.index("if (!gFixedOrientation) {")
+    fetch = method.index("SurfaceComposerClient::getDisplayState(display, &displayState);")
+    update = method.index("setDisplayProjection(t, virtualDpy, displayState);")
+    if not guarded < fetch < update:
+        raise AssertionError("G1198_DISPLAY_ORIENTATION_POLL_OUTSIDE_FIXED_GUARD")
+    # Original non-fixed behavior is intact and initial projection occurs once
+    # in prepareVirtualDisplay even if the fixed flag is passed.
+    create_start = source.index("static status_t prepareVirtualDisplay(")
+    create_end = source.index("static status_t writeWinscopeMetadata", create_start)
+    created = source[create_start:create_end]
+    if "setDisplayProjection(t, dpy, displayState);" not in created:
+        raise AssertionError("G1198_NO_INITIAL_DISPLAY_PROJECTION")
+    if "gFixedOrientation" in created:
+        raise AssertionError("G1198_UNEXPECTED_INITIAL_DISPLAY_PROJECTION_SUPPRESSION")
+    # G1197 opt-in crop still available independently and normal default stays.
+    for token in ("static bool gFillScreen = false;", "case 'F':\n            gFillScreen = true;",
+                  "if (gFillScreen) {", "static bool gRotate = false;"):
+        if token not in source:
+            raise AssertionError("G1198_BROKE_PRIOR_SCREENRECORD: " + token)
+
+
+def test():
+    source = SOURCE.read_text()
+    verify(source)
+    changes = [
+        ("static bool gFixedOrientation = false;", "static bool gFixedOrientation = true;"),
+        ("case 'L':\n            gFixedOrientation = true;",
+         "case 'L':\n            gFixedOrientation = false;"),
+        ("if (!gFixedOrientation) { // G1198:", "if (gFixedOrientation) { // G1198:"),
+        ('{ "fixed-orientation",  no_argument,        NULL, \'L\' },',
+         '{ "fixed-orientation",  no_argument,        NULL, \'X\' },'),
+        ("Stops recorder projection updates but does NOT lock Android UI rotation.",
+         "Locks entire Android UI rotation."),
+    ]
+    for old, replacement in changes:
+        if source.count(old) != 1:
+            raise AssertionError("G1198_BAD_MUTATION_FIXTURE")
+        mutated = source.replace(old, replacement)
+        try:
+            verify(mutated)
+        except AssertionError:
+            pass
+        else:
+            raise AssertionError("G1198_UNSAFE_MUTATION_ACCEPTED: " + old)
+    print("PASS G1198_ACTUAL_ANDROID_CPP_FIXED_PROJECTION_AND_5_FAIL_CLOSED_MUTANTS")
+    print("G1198_HOST_ONLY_NO_AUDIO_VIDEO_CAMERA_RECORDING_DEVICE_ACTIONS")
+
+
+if __name__ == "__main__":
+    test()
