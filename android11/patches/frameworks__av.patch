diff --git a/cmds/screenrecord/tests/g1197_center_crop_test.cpp b/cmds/screenrecord/tests/g1197_center_crop_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..40a7d5faecb22f635735485723896abd6c33bccc
--- /dev/null
+++ b/cmds/screenrecord/tests/g1197_center_crop_test.cpp
@@ -0,0 +1,38 @@
+// G1197 host-only regression for the EXACT header used by Android screenrecord.
+// No video, audio, camera, microphone, SurfaceFlinger or tablet is executed.
+#include "../ScreenrecordCenterCrop.h"
+#include <cassert>
+#include <cstdint>
+#include <cstdio>
+
+using smt311::CalculateCenterCrop;
+using smt311::CenterCrop;
+
+static void Verify(uint32_t sw, uint32_t sh, uint32_t vw, uint32_t vh,
+                   uint32_t left, uint32_t top, uint32_t width, uint32_t height) {
+    CenterCrop c{};
+    assert(CalculateCenterCrop(sw, sh, vw, vh, &c));
+    assert(c.left == left && c.top == top && c.width == width && c.height == height);
+    assert(c.width != 0 && c.height != 0);
+    assert(c.left + c.width <= sw && c.top + c.height <= sh);
+    assert((sw - c.width) / 2 == c.left);
+    assert((sh - c.height) / 2 == c.top);
+}
+int main() {
+    Verify(1280, 800, 1280, 720, 0, 40, 1280, 720);
+    Verify(800, 1280, 720, 1280, 40, 0, 720, 1280);
+    Verify(800, 1280, 1280, 720, 0, 415, 800, 450);
+    Verify(1280, 720, 1280, 720, 0, 0, 1280, 720);
+    Verify(1920, 1080, 1280, 720, 0, 0, 1920, 1080);
+    Verify(UINT32_MAX, UINT32_MAX, UINT32_MAX, UINT32_MAX,
+           0, 0, UINT32_MAX, UINT32_MAX);
+    CenterCrop c{1, 2, 3, 4};
+    assert(!CalculateCenterCrop(0, 800, 1280, 720, &c));
+    assert(!CalculateCenterCrop(1280, 0, 1280, 720, &c));
+    assert(!CalculateCenterCrop(1280, 720, 0, 720, &c));
+    assert(!CalculateCenterCrop(1280, 720, 1280, 0, &c));
+    assert(!CalculateCenterCrop(1280, 720, 1280, 720, nullptr));
+    assert(!CalculateCenterCrop(1, UINT32_MAX, UINT32_MAX, 1, &c));
+    std::puts("PASS G1197_EXACT_PRODUCTION_CENTER_CROP_HEADER_GEOMETRY_AND_EXTREMES");
+    std::puts("G1197_NO_RECORDING_NO_MEDIA_NO_DEVICE_ACTIONS");
+}
diff --git a/cmds/screenrecord/tests/test_g1198_fixed_orientation_source.py b/cmds/screenrecord/tests/test_g1198_fixed_orientation_source.py
