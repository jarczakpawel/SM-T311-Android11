+#pragma once
+
+// G1197: source-only screenrecord center-crop geometry.
+// Pure integer geometry is shared with host C++ regression tests. It does not
+// touch the physical device, SurfaceFlinger, camera, audio, or the encoder.
+#include <cstdint>
+
+namespace smt311 {
+struct CenterCrop {
+    uint32_t left;
+    uint32_t top;
+    uint32_t width;
+    uint32_t height;
+};
+
+// Preserve the target aspect without letterboxing by cropping the SOURCE.
+// Use uint64_t products to avoid overflowing on arbitrary display dimensions.
+static inline bool CalculateCenterCrop(uint32_t srcWidth, uint32_t srcHeight,
+                                       uint32_t videoWidth, uint32_t videoHeight,
+                                       CenterCrop* crop) {
+    if (!crop || !srcWidth || !srcHeight || !videoWidth || !videoHeight) return false;
+    uint32_t width = srcWidth;
+    uint32_t height = srcHeight;
+    if (uint64_t(srcWidth) * videoHeight > uint64_t(srcHeight) * videoWidth) {
+        width = uint32_t(uint64_t(srcHeight) * videoWidth / videoHeight);
+    } else {
+        height = uint32_t(uint64_t(srcWidth) * videoHeight / videoWidth);
+    }
+    if (!width || !height || width > srcWidth || height > srcHeight) return false;
+    crop->left = (srcWidth - width) / 2;
+    crop->top = (srcHeight - height) / 2;
+    crop->width = width;
+    crop->height = height;
+    return true;
+}
+}  // namespace smt311
