+namespace {
+constexpr char kDiag[] =
+    "/sys/devices/platform/i2c-9/i2c-9/9-0066/max77693-charger/t311_usb_role_diag";
+constexpr char kInterlock[] =
+    "/sys/devices/platform/i2c-9/i2c-9/9-0066/max77693-charger/t311_otg_interlock";
+constexpr char kArm[] =
+    "/sys/devices/platform/i2c-9/i2c-9/9-0066/max77693-charger/t311_otg_host_refresh";
+constexpr char kStop[] =
+    "/sys/devices/platform/i2c-9/i2c-9/9-0066/max77693-charger/t311_otg_host_stop";
+constexpr char kUdc[] = "/config/usb_gadget/g1/UDC";
+// XMM6262 is the internal HSIC device on usb1 port2. A pathname that
+// merely exists is not proof the modem was completely re-enumerated:
+// verify both read-only PCI/USB identity strings before sourcing VBUS.
+constexpr char kModemVendor[] = "/sys/bus/usb/devices/1-2/idVendor";
+constexpr char kModemProduct[] = "/sys/bus/usb/devices/1-2/idProduct";
+constexpr char kEhciPmControl[] =
+    "/sys/devices/platform/soc/12580000.usb/power/control";
+constexpr char kEhciPmStatus[] =
+    "/sys/devices/platform/soc/12580000.usb/power/runtime_status";
+using namespace std::chrono_literals;
+
+bool readInt(const std::string& str, const char* key, long* out) {
+    const std::string marker = std::string(key) + "=";
+    auto at = str.find(marker);
+    if (at == std::string::npos || (at > 0 && str[at - 1] != ' ' && str[at - 1] != '\n'))
+        return false;
+    const char* start = str.c_str() + at + marker.size();
+    char* end = nullptr;
+    errno = 0;
+    long number = strtol(start, &end, 0);
+    if (errno != 0 || start == end || (*end != ' ' && *end != '\n' && *end != '\0'))
+        return false;
+    *out = number;
+    return true;
+}
+
+bool readValue(const char* path, const char* key, long* out) {
+    std::string content;
+    return android::base::ReadFileToString(path, &content) && readInt(content, key, out);
+}
+
+bool hostPresent(bool* noExternalSource) {
+    long host = -1, device = -1, vbus = -1, known = -1;
+    std::string diag;
+    if (!android::base::ReadFileToString(kDiag, &diag) ||
+        !readInt(diag, "extcon_host", &host) ||
+        !readInt(diag, "extcon_usb", &device) ||
+        !readInt(diag, "vbus_present_known", &known) ||
+        !readInt(diag, "vbus_present", &vbus))
+        return false;
+    *noExternalSource = known == 1 && vbus == 0 && device == 0;
+    return host == 1;
+}
+
+bool hostStillConnected() {
+    long host = -1, device = -1;
+    std::string diag;
+    return android::base::ReadFileToString(kDiag, &diag) &&
+           readInt(diag, "extcon_host", &host) && host == 1 &&
+           readInt(diag, "extcon_usb", &device) && device == 0;
+}
+
+bool xmm6262Enumerated() {
+    std::string vendor;
+    std::string product;
+    // Exact, read-only IDs from the actual device; the preexisting
+    // SELinux sysfs_lt013g_modem_state label grants HAL both paths.
+    return android::base::ReadFileToString(kModemVendor, &vendor) &&
+           android::base::ReadFileToString(kModemProduct, &product) &&
+           (vendor == "1519\n" || vendor == "1519") &&
+           (product == "0020\n" || product == "0020");
+}
+
+bool hostResourcesReady() {
+    long phy0 = -1, host = -1, hsic0 = -1, hsic1 = -1, hcd = 0;
+    long hcdReady = 0, muxKnown = 0, muxHost = 0;
+    std::string diag;
+    if (!android::base::ReadFileToString(kDiag, &diag) ||
+        !readInt(diag, "phy0_device_owners", &phy0) ||
+        !readInt(diag, "phy1_host_owners", &host) ||
+        !readInt(diag, "phy_hsic0_owners", &hsic0) ||
+        !readInt(diag, "phy_hsic1_owners", &hsic1) ||
+        !readInt(diag, "host_runtime_flags", &hcd) ||
+        !readInt(diag, "host_hcd_ready_flags", &hcdReady) ||
+        !readInt(diag, "mode_switch_known", &muxKnown) ||
+        !readInt(diag, "mode_switch_host", &muxHost)) return false;
+    std::string udc;
+    if (!android::base::ReadFileToString(kUdc, &udc)) return false;
+    if (udc.find_first_not_of("\r\n \t") != std::string::npos) return false;
+    // Kernel enum Samsung USB2 HOST_EHCI=1, HOST_OHCI=2: flags BIT(1)|BIT(2).
+    // EHCI/OHCI both online, internal Comneon modem still present.
+    return phy0 == 0 && host > 0 && (hsic0 > 0 || hsic1 > 0) &&
+           (hcd & 0x2) && (hcdReady & 0x6) == 0x6 && muxKnown == 1 &&
+           muxHost == 1 && xmm6262Enumerated();
+}
+
+bool verifiedOff() {
+    long safe = 0, known = 0, pmic = 1, pending = 1, lease = 1;
+    std::string state;
+    return android::base::ReadFileToString(kInterlock, &state) &&
+           readInt(state, "safe_off", &safe) &&
+           readInt(state, "pmic_known", &known) &&
+           readInt(state, "pmic_boost", &pmic) &&
+           readInt(state, "pending", &pending) &&
+           readInt(state, "lease", &lease) &&
+           safe == 1 && known == 1 && pmic == 0 && pending == 0 && lease == 0;
+}
+
+bool verifiedOn() {
+    long boost = 0, known = 0, pmic = 0, pending = 1, lease = 0;
+    std::string state;
+    return android::base::ReadFileToString(kInterlock, &state) &&
+           readInt(state, "boost", &boost) &&
+           readInt(state, "pmic_known", &known) &&
+           readInt(state, "pmic_boost", &pmic) &&
+           readInt(state, "pending", &pending) &&
+           readInt(state, "lease", &lease) &&
+           boost == 1 && known == 1 && pmic == 1 && pending == 1 && lease == 1;
+}
+
+bool commandStop() {
+    return android::base::WriteStringToFile("1\n", kStop);
+}
+}  // namespace
+
+void UsbGadget::t311StopPower() {
+    if (mT311HostRole.load()) {
+        if (!commandStop()) {
+            ALOGE("T311_OTG HAL shutdown STOP failed; gadget remains detached");
+            return;
+        }
+        for (unsigned n = 0; n < 35 && !verifiedOff(); ++n)
+            std::this_thread::sleep_for(100ms);
+    }
+    if (!verifiedOff()) {
+        if (mT311HostRole.load() || mT311EhciPmHeld.load())
+            ALOGE("T311_OTG HAL shutdown PMIC OFF unverified; EHCI PM hold retained");
+        return;
+    }
+    if (mT311EhciPmHeld.load()) {
+        if (android::base::WriteStringToFile("auto\n", kEhciPmControl))
+            mT311EhciPmHeld.store(false);
+        else
+            ALOGE("T311_OTG HAL shutdown EHCI runtime PM restore failed");
+    }
+}
+
+void UsbGadget::t311RestoreDevice() {
+    // A failed STOP or a missing PMIC readback is NEVER a reason to
+    // reattach DWC2 to possibly still-powered external USB pins.
+    if (!commandStop()) {
+        ALOGE("T311_OTG STOP write failed: DWC2 remains detached");
+        return;
+    }
+    for (unsigned i = 0; i < 35 && !mT311WorkerStop.load(); ++i) {
+        if (verifiedOff()) break;
+        std::this_thread::sleep_for(100ms);
+    }
+    if (!verifiedOff()) {
+        ALOGE("T311_OTG PMIC OFF unverified; refusing gadget restore");
+        return;
+    }
+    bool clean = false;
+    if (hostPresent(&clean)) return;  // physical ID still grounded
+    // hostPresent false could also mean a read failure: require explicit
+    // readable EXTCON state before restoring the gadget.
+    long id = -1;
+    if (!readValue(kDiag, "extcon_host", &id) || id != 0) return;
+
+    // No active host ID, PMIC OFF and lease released. Gadget can reclaim PHY0.
+    mT311HostRole.store(false);
+    auto saved = mT311SavedFunctions.load();
+    setCurrentUsbFunctions(saved, nullptr, 3500);
+    // Release only our EHCI power/control override, never a preexisting one.
+    // PMIC BOOST is already verified OFF and HOST ID is no longer asserted.
+    if (mT311EhciPmHeld.load()) {
+        if (android::base::WriteStringToFile("auto\n", kEhciPmControl)) {
+            mT311EhciPmHeld.store(false);
+        } else {
+            ALOGE("T311_OTG failed to restore EHCI runtime PM auto");
+        }
+    }
+    ALOGI("T311_OTG restore gadget functions=%llu (USB PC path)",
+          static_cast<unsigned long long>(saved));
+}
+
+void UsbGadget::t311RoleWorker() {
+    unsigned stableHost = 0;
+    bool attempted = false;
+    bool poweredActive = false;
+    while (!mT311WorkerStop.load()) {
+        std::this_thread::sleep_for(350ms);
+        // Fail inert unless experimental kernel Kconfig AND board DT opt-in
+        // expose both PMIC control endpoints. No writes to running G463/G467
+        // production, and no changes to ADB/MTP while attached to PC.
+        if (access(kArm, F_OK) || access(kStop, F_OK) ||
+            access(kInterlock, R_OK) || access(kDiag, R_OK)) continue;
+        bool noSource = false;
+        bool host = hostPresent(&noSource);
+        if (!host && !noSource) {
+            // Check EXTCON_HOST explicitly, even if VBUS diagnostics fail.
+            long id = -1;
+            if (!readValue(kDiag, "extcon_host", &id)) continue;
+            host = id == 1;
+        }
+        if (host) {
+            if (poweredActive && (!hostStillConnected() || !hostResourcesReady() || !verifiedOn())) {
+                poweredActive = false;
+                attempted = true;
+                if (!commandStop()) {
+                    ALOGE("T311_OTG unsafe HOST state and STOP write failed");
+                } else {
+                    ALOGE("T311_OTG unsafe HOST state: STOP requested, no auto-retry");
+                }
+                continue;
+            }
+            if (poweredActive) {
+                if (!android::base::WriteStringToFile("1\n", kArm)) {
+                    poweredActive = false;
+                    attempted = true;
+                    commandStop();
+                    ALOGE("T311_OTG lease heartbeat failed; STOP and latch until detach");
+                }
+                continue;
+            }
+            if (stableHost < 3) ++stableHost;
+            if (stableHost < 3 || attempted || !noSource) continue;
+            attempted = true; // one arm attempt per adapter insertion
+            mT311HostRole.store(true);
+            mT311SavedFunctions.store(mCurrentUsbFunctions.load());
+            setCurrentUsbFunctions(static_cast<uint64_t>(V1_0::GadgetFunction::NONE),
+                                   nullptr, 0);
+            // After the gadget has relinquished PHY0, wake the EHCI host.
+            // The normal Android runtime PM policy may have suspended it.
+            // Do not touch a PC-connected cable or arm VBUS on PM errors.
+            bool hostNoSource = false;
+            bool ehciReady = false;
+            std::string pmControl;
+            if (hostPresent(&hostNoSource) && hostNoSource && verifiedOff()) {
+                std::string pmStatus;
+                /*
+                 * G731: The Exynos4212 EHCI is ALREADY runtime active on
+                 * the real SM-T311 (it still owns the XMM6262 HSIC modem).
+                 * Require the actual runtime status first; do not touch the
+                 * shared host power domain or write control unnecessarily.
+                 * Previous logic first read power/control (generic sysfs
+                 * SELinux label, AVC denied) and treated the whole host
+                 * path as unusable, followed by sticky STOP reason=6.
+                 */
+                if (android::base::ReadFileToString(kEhciPmStatus, &pmStatus) &&
+                    pmStatus.find("active") == 0) {
+                    ehciReady = true;
+                } else if (android::base::ReadFileToString(kEhciPmControl,
+                                                           &pmControl)) {
+                    if (pmControl == "auto\n" || pmControl == "auto") {
+                        // Take responsibility for restoring the prior auto.
+                        mT311EhciPmHeld.store(true);
+                        if (!android::base::WriteStringToFile("on\n", kEhciPmControl))
+                            ALOGE("T311_OTG EHCI runtime PM resume refused");
+                    }
+                    for (unsigned wake = 0; wake < 10 &&
+                            !mT311WorkerStop.load(); ++wake) {
+                        if (android::base::ReadFileToString(kEhciPmStatus,
+                                                           &pmStatus) &&
+                            pmStatus.find("active") == 0) {
+                            ehciReady = true;
+                            break;
+                        }
+                        std::this_thread::sleep_for(100ms);
+                    }
+                }
+            }
+            bool ready = false;
+            for (unsigned n=0; n<20 && !mT311WorkerStop.load(); ++n) {
+                bool noInput = false;
+                if (ehciReady && hostPresent(&noInput) && noInput &&
+                    hostResourcesReady()) {
+                    ready = true;
+                    break;
+                }
+                std::this_thread::sleep_for(100ms);
+            }
+            if (!ready) {
+                // No host-power session was started. A STOP while PMIC is
+                // already verified OFF creates a permanent reason=6 latch
+                // on older kernels, preventing a later valid insertion.
+                if (!verifiedOff())
+                    commandStop();
+                ALOGE("T311_OTG HOST not ready; PMIC remains OFF, wait for detach");
+                continue;
+            }
+            if (!android::base::WriteStringToFile("1\n", kArm)) {
+                if (!verifiedOff())
+                    commandStop();
+                ALOGE("T311_OTG kernel refused arm; no BOOST, wait for detach");
+                continue;
+            }
+            bool powered = false;
+            for (unsigned n=0; n<20 && !mT311WorkerStop.load(); ++n) {
+                if (verifiedOn()) { powered = true; break; }
+                std::this_thread::sleep_for(100ms);
+            }
+            if (!powered) {
+                commandStop();
+                ALOGE("T311_OTG BOOST not confirmed: waiting for physical detach");
+            } else {
+                poweredActive = true;
+                ALOGI("T311_OTG HOST powered, DWC2 detached, EHCI/HSIC preserved");
+            }
+        } else {
+            stableHost = 0;
+            poweredActive = false;
+            if (mT311HostRole.load()) {
+                t311RestoreDevice();
+                if (!mT311HostRole.load()) attempted = false;
+            } else {
+                attempted = false;
+                if (mT311EhciPmHeld.load() && verifiedOff()) {
+                    if (android::base::WriteStringToFile("auto\n", kEhciPmControl))
+                        mT311EhciPmHeld.store(false);
+                }
+            }
+        }
+    }
+}
+}  // namespace android::hardware::usb::gadget::V1_1::implementation
