+static int t311JpegDqCapture(int fd, v4l2_buffer* buffer, int timeoutMs) {
+    const nsecs_t deadline = systemTime(SYSTEM_TIME_MONOTONIC) +
+            static_cast<nsecs_t>(timeoutMs) * 1000000LL;
+    for (;;) {
+        if (t311JpegIoctl(fd, VIDIOC_DQBUF, buffer) == 0) {
+            return (buffer->flags & V4L2_BUF_FLAG_ERROR) ? -EIO : 0;
+        }
+        if (errno != EAGAIN && errno != EWOULDBLOCK) {
+            return -errno;
+        }
+
+        const nsecs_t remaining = deadline - systemTime(SYSTEM_TIME_MONOTONIC);
+        if (remaining <= 0) return -ETIMEDOUT;
+        pollfd pfd = {fd, POLLIN, 0};
+        const int pr = poll(&pfd, 1, static_cast<int>((remaining + 999999) / 1000000));
+        if (pr < 0) {
+            if (errno == EINTR) continue;
+            return -errno;
+        }
+        if (pfd.revents & (POLLERR | POLLHUP | POLLNVAL)) return -EIO;
+    }
+}
+
+// SMT311_Q34Y_ZERO_EXTRA_CMA_JPEG
+static int t311EncodeJpegHardwareNV12Dmabuf(
+        const Size& size, int inputDmabufFd, size_t inputAllocationBytes,
+        int outputDmabufFd, size_t outputAllocationBytes,
+        int jpegQuality, size_t& hwBytesUsed) {
+    hwBytesUsed = 0;
+    if (!size.width || !size.height || inputDmabufFd < 0 || outputDmabufFd < 0 ||
+            !inputAllocationBytes || !outputAllocationBytes) return -EINVAL;
+    if ((size.width & 1) || (size.height & 1)) return -EINVAL;
+
+    const size_t visibleBytes = static_cast<size_t>(size.width) * size.height * 3 / 2;
+    int fd = open("/dev/video4", O_RDWR | O_CLOEXEC | O_NONBLOCK);
+    if (fd < 0) return -errno;
+
+    bool srcStreaming = false, dstStreaming = false;
+    int ret = 0;
+    const char* failStep = nullptr;
+    size_t requiredInput = 0, requiredOutput = 0;
+
+    do {
+        v4l2_format srcFmt = {};
+        srcFmt.type = V4L2_BUF_TYPE_VIDEO_OUTPUT;
+        srcFmt.fmt.pix.width = size.width;
+        srcFmt.fmt.pix.height = size.height;
+        srcFmt.fmt.pix.pixelformat = V4L2_PIX_FMT_NV12;
+        srcFmt.fmt.pix.field = V4L2_FIELD_NONE;
+        srcFmt.fmt.pix.bytesperline = size.width;
+        srcFmt.fmt.pix.sizeimage = visibleBytes;
+        if (t311JpegIoctl(fd, VIDIOC_S_FMT, &srcFmt) < 0) { ret=-errno; failStep="s_fmt_output_nv12"; break; }
+
+        v4l2_format srcActual = {};
+        srcActual.type = V4L2_BUF_TYPE_VIDEO_OUTPUT;
+        if (t311JpegIoctl(fd, VIDIOC_G_FMT, &srcActual) < 0) { ret=-errno; failStep="g_fmt_output_nv12"; break; }
+        requiredInput = srcActual.fmt.pix.sizeimage;
+        if (inputAllocationBytes < requiredInput) { ret=-ENOSPC; failStep="input_dmabuf_too_small"; break; }
+
+        v4l2_format dstFmt = {};
+        dstFmt.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+        dstFmt.fmt.pix.width = size.width;
+        dstFmt.fmt.pix.height = size.height;
+        dstFmt.fmt.pix.pixelformat = V4L2_PIX_FMT_JPEG;
+        dstFmt.fmt.pix.field = V4L2_FIELD_NONE;
+        dstFmt.fmt.pix.sizeimage = outputAllocationBytes;
+        if (t311JpegIoctl(fd, VIDIOC_S_FMT, &dstFmt) < 0) { ret=-errno; failStep="s_fmt_capture_jpeg"; break; }
+
+        v4l2_format dstActual = {};
+        dstActual.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+        if (t311JpegIoctl(fd, VIDIOC_G_FMT, &dstActual) < 0) { ret=-errno; failStep="g_fmt_capture_jpeg"; break; }
+        requiredOutput = dstActual.fmt.pix.sizeimage;
+        if (outputAllocationBytes < requiredOutput) { ret=-ENOSPC; failStep="output_dmabuf_too_small"; break; }
+
+        const int androidQuality = std::max(1, std::min(100, jpegQuality));
+        const int hwQuality = androidQuality >= 80 ? 3 : (androidQuality >= 74 ? 2 : (androidQuality >= 65 ? 1 : 0));
+        v4l2_control quality = {};
+        quality.id = V4L2_CID_JPEG_COMPRESSION_QUALITY;
+        quality.value = hwQuality;
+        if (t311JpegIoctl(fd, VIDIOC_S_CTRL, &quality) < 0) { ret=-errno; failStep="s_ctrl_quality"; break; }
+
+        v4l2_requestbuffers srcReq = {};
+        srcReq.type = V4L2_BUF_TYPE_VIDEO_OUTPUT;
+        srcReq.memory = V4L2_MEMORY_DMABUF;
+        srcReq.count = 1;
+        if (t311JpegIoctl(fd, VIDIOC_REQBUFS, &srcReq) < 0 || srcReq.count < 1) {
+            ret = errno ? -errno : -ENOMEM; failStep="reqbufs_output_dmabuf"; break;
+        }
+        v4l2_requestbuffers dstReq = {};
+        dstReq.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+        dstReq.memory = V4L2_MEMORY_DMABUF;
+        dstReq.count = 1;
+        if (t311JpegIoctl(fd, VIDIOC_REQBUFS, &dstReq) < 0 || dstReq.count < 1) {
+            ret = errno ? -errno : -ENOMEM; failStep="reqbufs_capture_dmabuf"; break;
+        }
+
+        v4l2_buffer dstBuf = {};
+        dstBuf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+        dstBuf.memory = V4L2_MEMORY_DMABUF;
+        dstBuf.index = 0;
+        dstBuf.m.fd = outputDmabufFd;
+        dstBuf.length = outputAllocationBytes;
+        if (t311JpegIoctl(fd, VIDIOC_QBUF, &dstBuf) < 0) { ret=-errno; failStep="qbuf_capture_dmabuf"; break; }
+
+        v4l2_buffer srcBuf = {};
+        srcBuf.type = V4L2_BUF_TYPE_VIDEO_OUTPUT;
+        srcBuf.memory = V4L2_MEMORY_DMABUF;
+        srcBuf.index = 0;
+        srcBuf.m.fd = inputDmabufFd;
+        srcBuf.length = inputAllocationBytes;
+        srcBuf.bytesused = visibleBytes;
+        if (t311JpegIoctl(fd, VIDIOC_QBUF, &srcBuf) < 0) { ret=-errno; failStep="qbuf_output_dmabuf"; break; }
+
+        v4l2_buf_type capType = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+        if (t311JpegIoctl(fd, VIDIOC_STREAMON, &capType) < 0) { ret=-errno; failStep="streamon_capture"; break; }
+        dstStreaming = true;
+        v4l2_buf_type outType = V4L2_BUF_TYPE_VIDEO_OUTPUT;
+        if (t311JpegIoctl(fd, VIDIOC_STREAMON, &outType) < 0) { ret=-errno; failStep="streamon_output"; break; }
+        srcStreaming = true;
+
+        memset(&dstBuf, 0, sizeof(dstBuf));
+        dstBuf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+        dstBuf.memory = V4L2_MEMORY_DMABUF;
+        ret = t311JpegDqCapture(fd, &dstBuf, 5000);
+        if (ret != 0) { failStep="dqbuf_capture"; break; }
+        hwBytesUsed = dstBuf.bytesused;
+        ret = 0;
+        ALOGI("SMT311_Q34Y_JPEG_BLOB_DMABUF_HW=PASS size=%ux%u in_alloc=%zu in_required=%zu out_alloc=%zu out_required=%zu bytesused=%zu q=%d",
+              size.width, size.height, inputAllocationBytes, requiredInput,
+              outputAllocationBytes, requiredOutput, hwBytesUsed, androidQuality);
+    } while (false);
+
+    if (srcStreaming) { v4l2_buf_type t=V4L2_BUF_TYPE_VIDEO_OUTPUT; t311JpegIoctl(fd, VIDIOC_STREAMOFF, &t); }
+    if (dstStreaming) { v4l2_buf_type t=V4L2_BUF_TYPE_VIDEO_CAPTURE; t311JpegIoctl(fd, VIDIOC_STREAMOFF, &t); }
+    ::close(fd);
+    if (ret != 0) ALOGW("SMT311_Q34Y_JPEG_BLOB_DMABUF_HW=FAIL step=%s rc=%d", failStep ? failStep : "unknown", ret);
+    return ret;
+}
+
+static int t311EncodeJpegHardwareYU12(
+        const Size& size, const YCbCrLayout& inLayout, int jpegQuality,
+        const void* app1Buffer, size_t app1Size,
+        void* outBuffer, size_t maxOutSize, size_t& actualCodeSize) {
+    actualCodeSize = 0;
+    if (size.width == 0 || size.height == 0 || outBuffer == nullptr) {
+        return -EINVAL;
+    }
+    if ((size.width & 1) || (size.height & 1)) {
+        ALOGW("SMT311_Q31Q_JPEG_HW=FAIL step=odd_size size=%ux%u",
+                size.width, size.height);
+        return -EINVAL;
+    }
+    if (app1Size > 65533) {
+        ALOGW("SMT311_Q31Q_JPEG_HW=FAIL step=app1_too_large bytes=%zu", app1Size);
+        return -E2BIG;
+    }
+
+    ALOGI("SMT311_Q31Q_JPEG_HW=START size=%ux%u q=%d app1=%zu",
+            size.width, size.height, jpegQuality, app1Size);
+
+    int fd = open("/dev/video4", O_RDWR | O_CLOEXEC | O_NONBLOCK);
+    if (fd < 0) {
+        const int e = errno;
+        ALOGW("SMT311_Q31Q_JPEG_HW=FAIL step=open errno=%d:%s", e, strerror(e));
+        return -e;
+    }
+
+    T311JpegMap srcMap, dstMap;
+    v4l2_buffer srcBuf = {}, dstBuf = {};
+    bool srcStreaming = false;
+    bool dstStreaming = false;
+    int ret = 0;
+    const char* failStep = nullptr;
+
+    do {
+        v4l2_format srcFmt = {};
+        srcFmt.type = V4L2_BUF_TYPE_VIDEO_OUTPUT;
+        srcFmt.fmt.pix.width = size.width;
+        srcFmt.fmt.pix.height = size.height;
+        srcFmt.fmt.pix.pixelformat = V4L2_PIX_FMT_YUV420;
+        srcFmt.fmt.pix.field = V4L2_FIELD_NONE;
+        srcFmt.fmt.pix.sizeimage = size.width * size.height * 3 / 2;
+        if (t311JpegIoctl(fd, VIDIOC_S_FMT, &srcFmt) < 0) {
+            ret = -errno; failStep = "s_fmt_output"; break;
+        }
+
+        v4l2_format dstFmt = {};
+        dstFmt.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+        dstFmt.fmt.pix.width = size.width;
+        dstFmt.fmt.pix.height = size.height;
+        dstFmt.fmt.pix.pixelformat = V4L2_PIX_FMT_JPEG;
+        dstFmt.fmt.pix.field = V4L2_FIELD_NONE;
+        dstFmt.fmt.pix.sizeimage = maxOutSize;
+        if (t311JpegIoctl(fd, VIDIOC_S_FMT, &dstFmt) < 0) {
+            ret = -errno; failStep = "s_fmt_capture"; break;
+        }
+
+        // The current s5p-jpeg driver exposes only four quantization
+        // tables (control range 0..3), while Camera2 supplies JPEG_QUALITY
+        // in the Android 1..100 scale.  Q31P proved that passing 90
+        // directly merely gets clamped to 3 by V4L2.  Map monotonically
+        // to the four actual Exynos tables instead.
+        const int androidQuality = std::max(1, std::min(100, jpegQuality));
+        int hwQuality = 0;
+        // The current tables are roughly ordered around IJG Q59/Q71/Q76/Q84.
+        // Mid-point thresholds keep the mapping monotonic and closest to
+        // the requested Android quality.
+        if (androidQuality >= 80) {
+            hwQuality = 3;
+        } else if (androidQuality >= 74) {
+            hwQuality = 2;
+        } else if (androidQuality >= 65) {
+            hwQuality = 1;
+        }
+
+        v4l2_control quality = {};
+        quality.id = V4L2_CID_JPEG_COMPRESSION_QUALITY;
+        quality.value = hwQuality;
+        if (t311JpegIoctl(fd, VIDIOC_S_CTRL, &quality) < 0) {
+            ret = -errno; failStep = "s_ctrl_quality"; break;
+        }
+        ALOGI("SMT311_Q31Q_JPEG_QUALITY android=%d hw_level=%d",
+                androidQuality, hwQuality);
+
+        if (!t311JpegAllocMmap(fd, V4L2_BUF_TYPE_VIDEO_OUTPUT, &srcMap, &srcBuf)) {
+            ret = -errno; failStep = "alloc_output"; break;
+        }
+        if (!t311JpegAllocMmap(fd, V4L2_BUF_TYPE_VIDEO_CAPTURE, &dstMap, &dstBuf)) {
+            ret = -errno; failStep = "alloc_capture"; break;
+        }
+        // Q31Q: make EOI diagnostics deterministic.  The Exynos4 stream-size
+        // register is not trusted until we compare it with the actual JPEG.
+        memset(dstMap.addr, 0, dstMap.length);
+
+        const size_t yBytes = static_cast<size_t>(size.width) * size.height;
+        const uint32_t cWidth = (size.width + 1) / 2;
+        const uint32_t cHeight = (size.height + 1) / 2;
+        const size_t cBytes = static_cast<size_t>(cWidth) * cHeight;
+        const size_t frameBytes = yBytes + 2 * cBytes;
+        if (frameBytes > srcMap.length) {
+            ret = -ENOSPC; failStep = "output_buffer_short"; break;
+        }
+
+        memset(srcMap.addr, 0, srcMap.length);
+        uint8_t* dstY = static_cast<uint8_t*>(srcMap.addr);
+        uint8_t* dstU = dstY + yBytes;
+        uint8_t* dstV = dstU + cBytes;
+        const int copyRet = libyuv::I420Copy(
+                static_cast<const uint8_t*>(inLayout.y), inLayout.yStride,
+                static_cast<const uint8_t*>(inLayout.cb), inLayout.cStride,
+                static_cast<const uint8_t*>(inLayout.cr), inLayout.cStride,
+                dstY, size.width, dstU, cWidth, dstV, cWidth,
+                size.width, size.height);
+        if (copyRet != 0) {
+            ret = -EIO; failStep = "i420_copy"; break;
+        }
+
+        srcBuf.bytesused = srcFmt.fmt.pix.sizeimage ?
+                srcFmt.fmt.pix.sizeimage : frameBytes;
+        if (srcBuf.bytesused > srcMap.length) {
+            srcBuf.bytesused = frameBytes;
+        }
+
+        if (t311JpegIoctl(fd, VIDIOC_QBUF, &dstBuf) < 0) {
+            ret = -errno; failStep = "qbuf_capture"; break;
+        }
+        if (t311JpegIoctl(fd, VIDIOC_QBUF, &srcBuf) < 0) {
+            ret = -errno; failStep = "qbuf_output"; break;
+        }
+
+        v4l2_buf_type capType = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+        if (t311JpegIoctl(fd, VIDIOC_STREAMON, &capType) < 0) {
+            ret = -errno; failStep = "streamon_capture"; break;
+        }
+        dstStreaming = true;
+
+        v4l2_buf_type outType = V4L2_BUF_TYPE_VIDEO_OUTPUT;
+        if (t311JpegIoctl(fd, VIDIOC_STREAMON, &outType) < 0) {
+            ret = -errno; failStep = "streamon_output"; break;
+        }
+        srcStreaming = true;
+
+        memset(&dstBuf, 0, sizeof(dstBuf));
+        dstBuf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+        dstBuf.memory = V4L2_MEMORY_MMAP;
+        ret = t311JpegDqCapture(fd, &dstBuf, 5000);
+        if (ret != 0) {
+            failStep = "dqbuf_capture"; break;
+        }
+
+        const size_t hwReportedSize = dstBuf.bytesused;
+        const auto* hw = static_cast<const uint8_t*>(dstMap.addr);
+        if (hwReportedSize < 4 || hwReportedSize > dstMap.length ||
+                hw[0] != 0xff || hw[1] != 0xd8) {
+            ALOGW("SMT311_Q31Q_JPEG_STREAM_DIAG reported=%zu map=%zu "
+                  "soi=%d first=%02x%02x",
+                    hwReportedSize, dstMap.length,
+                    (hwReportedSize >= 2 && hw[0] == 0xff && hw[1] == 0xd8) ? 1 : 0,
+                    dstMap.length > 0 ? hw[0] : 0,
+                    dstMap.length > 1 ? hw[1] : 0);
+            ret = -EBADMSG; failStep = "jpeg_soi_or_size"; break;
+        }
+
+        // Exynos4 exposes an encoded stream-size register through bytesused.
+        // Q31O showed successful IRQ/DQBUF jobs for which FF D9 was not at
+        // bytesused-2.  Search the deterministic (pre-zeroed) output for the
+        // real EOI.  First cover bytesused, then a 4 KiB guard for a possible
+        // under-reported hardware counter.
+        const size_t scanLimit = std::min(
+                dstMap.length, hwReportedSize + static_cast<size_t>(4096));
+        size_t jpegPayloadSize = 0;
+        for (size_t i = scanLimit; i >= 2; --i) {
+            if (hw[i - 2] == 0xff && hw[i - 1] == 0xd9) {
+                jpegPayloadSize = i;
+                break;
+            }
+            if (i == 2) break;
+        }
+
+        if (jpegPayloadSize == 0) {
+            const size_t t = hwReportedSize;
+            ALOGW("SMT311_Q31Q_JPEG_STREAM_DIAG reported=%zu map=%zu "
+                  "scan=%zu eoi=NONE tail=%02x%02x%02x%02x%02x%02x%02x%02x",
+                    hwReportedSize, dstMap.length, scanLimit,
+                    t >= 8 ? hw[t - 8] : 0, t >= 7 ? hw[t - 7] : 0,
+                    t >= 6 ? hw[t - 6] : 0, t >= 5 ? hw[t - 5] : 0,
+                    t >= 4 ? hw[t - 4] : 0, t >= 3 ? hw[t - 3] : 0,
+                    t >= 2 ? hw[t - 2] : 0, t >= 1 ? hw[t - 1] : 0);
+            ret = -EBADMSG; failStep = "jpeg_eoi_missing"; break;
+        }
+
+        const ssize_t delta = static_cast<ssize_t>(jpegPayloadSize) -
+                static_cast<ssize_t>(hwReportedSize);
+        ALOGI("SMT311_Q31Q_JPEG_STREAM_SIZE reported=%zu effective=%zu "
+              "delta=%zd normalized=%d",
+                hwReportedSize, jpegPayloadSize, delta,
+                jpegPayloadSize != hwReportedSize ? 1 : 0);
+
+        size_t finalSize = jpegPayloadSize;
+        if (app1Buffer != nullptr && app1Size != 0) {
+            finalSize += 4 + app1Size;
+        }
+        if (finalSize > maxOutSize) {
+            ret = -ENOSPC; failStep = "hal_blob_short"; break;
+        }
+
+        auto* out = static_cast<uint8_t*>(outBuffer);
+        if (app1Buffer != nullptr && app1Size != 0) {
+            out[0] = 0xff;
+            out[1] = 0xd8;
+            out[2] = 0xff;
+            out[3] = 0xe1;
+            const uint16_t markerLength = static_cast<uint16_t>(app1Size + 2);
+            out[4] = static_cast<uint8_t>(markerLength >> 8);
+            out[5] = static_cast<uint8_t>(markerLength & 0xff);
+            memcpy(out + 6, app1Buffer, app1Size);
+            memcpy(out + 6 + app1Size, hw + 2, jpegPayloadSize - 2);
+        } else {
+            memcpy(out, hw, jpegPayloadSize);
+        }
+        actualCodeSize = finalSize;
+        ret = 0;
+
+        ALOGI("SMT311_Q31Q_JPEG_HW=PASS size=%ux%u android_q=%d hw_level=%d "
+              "reported=%zu jpeg_bytes=%zu final_bytes=%zu app1=%zu",
+                size.width, size.height, androidQuality, quality.value,
+                hwReportedSize, jpegPayloadSize, finalSize, app1Size);
+    } while (false);
+
+    if (srcStreaming) {
+        v4l2_buf_type type = V4L2_BUF_TYPE_VIDEO_OUTPUT;
+        t311JpegIoctl(fd, VIDIOC_STREAMOFF, &type);
+    }
+    if (dstStreaming) {
+        v4l2_buf_type type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+        t311JpegIoctl(fd, VIDIOC_STREAMOFF, &type);
+    }
+    if (srcMap.addr != MAP_FAILED) munmap(srcMap.addr, srcMap.length);
+    if (dstMap.addr != MAP_FAILED) munmap(dstMap.addr, dstMap.length);
+    close(fd);
+
+    if (ret != 0) {
+        ALOGW("SMT311_Q31Q_JPEG_HW=FAIL step=%s rc=%d errno=%d:%s",
+                failStep ? failStep : "unknown", ret, ret < 0 ? -ret : ret,
+                strerror(ret < 0 ? -ret : ret));
+    }
+    return ret;
+}
