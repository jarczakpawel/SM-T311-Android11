+static int t311WaitCaptureReady(int fd, int timeoutMs) {
+    const nsecs_t deadline = systemTime(SYSTEM_TIME_MONOTONIC) +
+            static_cast<nsecs_t>(timeoutMs) * 1000000LL;
+    for (;;) {
+        const nsecs_t remaining = deadline - systemTime(SYSTEM_TIME_MONOTONIC);
+        if (remaining <= 0) return -ETIMEDOUT;
+        pollfd pfd = {fd, POLLIN, 0};
+        const int ret = poll(&pfd, 1, static_cast<int>((remaining + 999999) / 1000000));
+        if (ret < 0) {
+            if (errno == EINTR) continue;
+            return -errno;
+        }
+        if (pfd.revents & (POLLERR | POLLHUP | POLLNVAL)) return -EIO;
+        if (pfd.revents & POLLIN) return 0;
+    }
