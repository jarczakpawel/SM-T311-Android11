+// SPDX-License-Identifier: Apache-2.0
+#ifndef ANDROID_USB_GADGET_T311_FFS_READINESS_H
+#define ANDROID_USB_GADGET_T311_FFS_READINESS_H
+
+#include <cstdio>
+#include <unistd.h>
+
+// Small independent predicate usable both by the Android HAL and by the
+// host-built deterministic tests. It reads endpoint *existence only*.
+// Never opens an endpoint, binds a UDC or changes any USB hardware state.
+inline bool t311FfsEndpointsReady(const char* dir, int count) {
+    if (!dir || count <= 0) return false;
+    char endpoint[256];
+    for (int ep = 1; ep <= count; ++ep) {
+        int n = snprintf(endpoint, sizeof(endpoint), "%s/ep%d", dir, ep);
+        if (n < 0 || static_cast<size_t>(n) >= sizeof(endpoint) ||
+            access(endpoint, F_OK) != 0) return false;
+    }
+    return true;
+}
+
+#endif  // ANDROID_USB_GADGET_T311_FFS_READINESS_H
