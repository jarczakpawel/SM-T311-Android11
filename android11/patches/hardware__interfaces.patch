+static SupportedV4L2Format t311PickSensorMode(
+        const std::vector<SupportedV4L2Format>& formats,
+        const std::string& cameraId, bool still, uint32_t targetW, uint32_t targetH) {
+    SupportedV4L2Format best {.width = 0, .height = 0};
+    double bestScore = 1.0e30;
+    const double targetAr = targetH ? static_cast<double>(targetW) / targetH : 4.0 / 3.0;
+    bool foundCovering = false;
+
+    for (const auto& fmt : formats) {
+        const bool allowed = still ? t311StillSensorMode(cameraId, fmt.width, fmt.height) :
+                                     t311RealtimeSensorMode(cameraId, fmt.width, fmt.height);
+        if (!allowed) continue;
+        const bool covering = fmt.width >= targetW && fmt.height >= targetH;
+        if (foundCovering && !covering) continue;
+        if (!foundCovering && covering) {
+            foundCovering = true;
+            best = SupportedV4L2Format{.width = 0, .height = 0};
+            bestScore = 1.0e30;
+        }
+        const double ar = static_cast<double>(fmt.width) / fmt.height;
+        const double arPenalty = std::fabs(ar - targetAr) * 1000000000.0;
+        const double area = static_cast<double>(fmt.width) * fmt.height;
+        const double sizePenalty = covering ? area : -area;
+        const double score = arPenalty + sizePenalty;
+        if (score < bestScore) {
+            bestScore = score;
+            best = fmt;
+        }
+    }
+    return best;
+}
