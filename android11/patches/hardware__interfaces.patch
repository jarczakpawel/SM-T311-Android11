+// SPDX-License-Identifier: Apache-2.0
+// SM-T311 Exynos4212 microUSB role coordinator, G468.
+// The DWC2 remains peripheral-only. External HOST uses Exynos EHCI/OHCI.
+// In production the controls below DO NOT EXIST: worker is entirely inert.
+#include "UsbGadget.h"
+
