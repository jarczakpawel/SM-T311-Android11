+static int t311RotatorCopyNv12(int srcFd, uint32_t srcStride, uint32_t width, uint32_t height,
+        const T311GrallocBufferInfo& dst) {
+    if (srcFd < 0 || width == 0 || height == 0 || srcStride < width ||
+            dst.num_fds < 2 || dst.fds[0] < 0 || dst.fds[1] < 0 ||
+            dst.stride[0] < width || dst.stride[1] < width) return -EINVAL;
+    const char* failStep = "probe";
+    int ret = t311RotatorProbe();
+    if (ret) return ret;
+    auto& ctx = gT311Rotator;
+    uint32_t srcGem = 0, dstYGem = 0, dstCGem = 0;
+    failStep = "prime_src";
+    ret = t311DrmPrimeImport(ctx.fd, srcFd, &srcGem);
+    if (ret) goto out;
+    failStep = "prime_dst_y";
+    ret = t311DrmPrimeImport(ctx.fd, dst.fds[0], &dstYGem);
+    if (ret) goto out;
+    if (dst.fds[1] == dst.fds[0]) dstCGem = dstYGem;
+    else {
+        failStep = "prime_dst_uv";
+        ret = t311DrmPrimeImport(ctx.fd, dst.fds[1], &dstCGem);
+        if (ret) goto out;
+    }
+    {
+        T311IppTaskBuffer params[2]{};
+        auto& src = params[0];
+        src.id = T311_IPP_TASK_BUFFER | T311_IPP_TASK_TYPE_SOURCE;
+        src.fourcc = T311_DRM_FORMAT_NV12;
+        src.width = width; src.height = height;
+        src.gem_id[0] = srcGem; src.gem_id[1] = srcGem;
+        src.offset[0] = 0; src.offset[1] = srcStride * height;
+        src.pitch[0] = srcStride; src.pitch[1] = srcStride;
+        auto& outBuf = params[1];
+        outBuf.id = T311_IPP_TASK_BUFFER | T311_IPP_TASK_TYPE_DESTINATION;
+        outBuf.fourcc = T311_DRM_FORMAT_NV12;
+        outBuf.width = width; outBuf.height = height;
+        outBuf.gem_id[0] = dstYGem; outBuf.gem_id[1] = dstCGem;
+        outBuf.offset[0] = dst.offset[0]; outBuf.offset[1] = dst.offset[1];
+        outBuf.pitch[0] = dst.stride[0]; outBuf.pitch[1] = dst.stride[1];
+        T311IppCommit commit{};
+        commit.ipp_id = ctx.ippId;
+        commit.params_size = sizeof(params);
+        commit.params_ptr = static_cast<uint64_t>(reinterpret_cast<uintptr_t>(params));
+        failStep = "commit";
+        if (t311DrmIoctl(ctx.fd, T311_DRM_IOCTL_EXYNOS_IPP_COMMIT, &commit) != 0)
+            ret = -errno;
+        else ret = 0;
+    }
+out:
+    if (dstCGem && dstCGem != dstYGem) t311DrmGemClose(ctx.fd, dstCGem);
+    t311DrmGemClose(ctx.fd, dstYGem);
+    t311DrmGemClose(ctx.fd, srcGem);
+    if (ret && !ctx.announced) {
+        ALOGW("SMT311_Q35W_ROTATOR_COPY=FALLBACK step=%s rc=%d", failStep, ret);
+        ctx.announced = true;
+    }
+    return ret;
+}
