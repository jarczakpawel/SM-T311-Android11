+// SM-T311 H27 sensor controls are merged into FIMC video nodes by the kernel.
+static bool t311HasCtrl(int fd, uint32_t id) {
+    struct v4l2_queryctrl q = {};
+    q.id = id;
+    return TEMP_FAILURE_RETRY(ioctl(fd, VIDIOC_QUERYCTRL, &q)) == 0 &&
+           !(q.flags & V4L2_CTRL_FLAG_DISABLED);
+}
+
+static int t311SetCtrl(int fd, uint32_t id, int32_t value) {
+    struct v4l2_control c = {};
+    c.id = id; c.value = value;
+    int r = TEMP_FAILURE_RETRY(ioctl(fd, VIDIOC_S_CTRL, &c));
+    if (r != 0) ALOGW("PJARCZAK H27B S_CTRL id=0x%x value=%d failed: %s", id, value, strerror(errno));
+    return r;
+}
+
+static int t311GetCtrl(int fd, uint32_t id, int32_t* value) {
+    struct v4l2_control c = {};
+    c.id = id;
+    int r = TEMP_FAILURE_RETRY(ioctl(fd, VIDIOC_G_CTRL, &c));
+    if (r == 0 && value) *value = c.value;
+    return r;
+}
+
+static int t311MapAwb(uint8_t v) {
+    switch (v) {
+        case ANDROID_CONTROL_AWB_MODE_INCANDESCENT: return V4L2_WHITE_BALANCE_INCANDESCENT;
+        case ANDROID_CONTROL_AWB_MODE_FLUORESCENT: return V4L2_WHITE_BALANCE_FLUORESCENT;
+        case ANDROID_CONTROL_AWB_MODE_DAYLIGHT: return V4L2_WHITE_BALANCE_DAYLIGHT;
+        case ANDROID_CONTROL_AWB_MODE_CLOUDY_DAYLIGHT: return V4L2_WHITE_BALANCE_CLOUDY;
+        default: return V4L2_WHITE_BALANCE_AUTO;
+    }
+}
+
+static int t311MapEffect(uint8_t v) {
+    switch (v) {
+        case ANDROID_CONTROL_EFFECT_MODE_MONO: return V4L2_COLORFX_BW;
+        case ANDROID_CONTROL_EFFECT_MODE_SEPIA: return V4L2_COLORFX_SEPIA;
+        case ANDROID_CONTROL_EFFECT_MODE_NEGATIVE: return V4L2_COLORFX_NEGATIVE;
+        case ANDROID_CONTROL_EFFECT_MODE_SOLARIZE: return V4L2_COLORFX_SOLARIZATION;
+        default: return V4L2_COLORFX_NONE;
+    }
+}
+
+static int t311MapScene(uint8_t v) {
+    switch (v) {
+        case ANDROID_CONTROL_SCENE_MODE_PORTRAIT: return V4L2_SCENE_MODE_PORTRAIT;
+        case ANDROID_CONTROL_SCENE_MODE_LANDSCAPE: return V4L2_SCENE_MODE_LANDSCAPE;
+        case ANDROID_CONTROL_SCENE_MODE_NIGHT: return V4L2_SCENE_MODE_NIGHT;
+        case ANDROID_CONTROL_SCENE_MODE_BEACH: return V4L2_SCENE_MODE_BEACH_SNOW;
+        case ANDROID_CONTROL_SCENE_MODE_SUNSET: return V4L2_SCENE_MODE_SUNSET;
+        case ANDROID_CONTROL_SCENE_MODE_FIREWORKS: return V4L2_SCENE_MODE_FIREWORKS;
+        case ANDROID_CONTROL_SCENE_MODE_SPORTS: return V4L2_SCENE_MODE_SPORTS;
+        case ANDROID_CONTROL_SCENE_MODE_PARTY: return V4L2_SCENE_MODE_PARTY_INDOOR;
+        case ANDROID_CONTROL_SCENE_MODE_CANDLELIGHT: return V4L2_SCENE_MODE_CANDLE_LIGHT;
+        default: return V4L2_SCENE_MODE_NONE;
+    }
+}
+
+static bool t311SetCtrlIfChanged(int fd, uint32_t id, int32_t value,
+                                  std::unordered_map<uint32_t, int32_t>* cache) {
+    auto it = cache->find(id);
+    if (it != cache->end() && it->second == value) return true;
+    if (t311SetCtrl(fd, id, value) != 0) return false;
+    (*cache)[id] = value;
+    return true;
+}
