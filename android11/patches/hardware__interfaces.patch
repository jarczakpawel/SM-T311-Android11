+static bool t311RealtimeSensorMode(const std::string& cameraId, uint32_t w, uint32_t h) {
+    if (cameraId == "0") {
+        return (w == 176 && h == 144) || (w == 320 && h == 240) ||
+               (w == 352 && h == 288) || (w == 528 && h == 432) ||
+               (w == 640 && h == 480) || (w == 720 && h == 480) ||
+               (w == 880 && h == 720) || (w == 1024 && h == 576) ||
+               (w == 1024 && h == 768) || (w == 1280 && h == 720);
+    }
+    if (cameraId == "1") {
+        return (w == 320 && h == 240) || (w == 352 && h == 288) ||
+               (w == 640 && h == 360) || (w == 640 && h == 480);
+    }
+    return true;
+}
+
+static bool t311StillSensorMode(const std::string& cameraId, uint32_t w, uint32_t h) {
+    if (cameraId == "0") {
+        return (w == 640 && h == 480) || (w == 960 && h == 720) ||
+               (w == 1536 && h == 864) || (w == 1600 && h == 1200) ||
+               (w == 2048 && h == 1152) || (w == 2048 && h == 1536) ||
+               (w == 2560 && h == 1440) || (w == 2560 && h == 1920);
+    }
+    if (cameraId == "1") {
+        return (w == 640 && h == 480) || (w == 1280 && h == 720) ||
+               (w == 1280 && h == 960);
+    }
+    return true;
+}
