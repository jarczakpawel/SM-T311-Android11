+static bool t311JpegAllocMmap(int fd, v4l2_buf_type type,
+        T311JpegMap* map, v4l2_buffer* buffer) {
+    v4l2_requestbuffers req = {};
+    req.type = type;
+    req.memory = V4L2_MEMORY_MMAP;
+    req.count = 1;
+    if (t311JpegIoctl(fd, VIDIOC_REQBUFS, &req) < 0 || req.count < 1) {
+        return false;
+    }
+
+    memset(buffer, 0, sizeof(*buffer));
+    buffer->type = type;
+    buffer->memory = V4L2_MEMORY_MMAP;
+    buffer->index = 0;
+    if (t311JpegIoctl(fd, VIDIOC_QUERYBUF, buffer) < 0) {
+        return false;
+    }
+
+    map->length = buffer->length;
+    map->addr = mmap(nullptr, map->length, PROT_READ | PROT_WRITE,
+            MAP_SHARED, fd, buffer->m.offset);
+    return map->addr != MAP_FAILED;
+}
