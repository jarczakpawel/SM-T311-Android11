+// Standalone Exynos G2D userspace ABI test library (offline, not PRODUCT_PACKAGES).
+cc_library_static {
+    name: "libexynos_g2d_t311_offline",
+    srcs: ["exynos_drm.c", "exynos_fimg2d.c"],
+    vendor: true,
+    shared_libs: ["libdrm"],
+    local_include_dirs: ["."],
+    cflags: ["-Wno-unused-parameter", "-Wno-deprecated-declarations"],
+}
