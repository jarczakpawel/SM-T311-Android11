-	if (dst_y + dst->height > h)
-		dst_h = dst->height - dst_y;
+	/* Check origins before subtraction to avoid unsigned underflow.
+	 * Clip the requested width and height against BOTH buffer extents.
+	 */
+	if (!w || !h || src_x >= src->width || src_y >= src->height ||
+	    dst_x >= dst->width || dst_y >= dst->height)
+		return -EINVAL;
 
+	src_w = MIN(w, src->width - src_x);
+	src_h = MIN(h, src->height - src_y);
+	dst_w = MIN(w, dst->width - dst_x);
+	dst_h = MIN(h, dst->height - dst_y);
 	w = MIN(src_w, dst_w);
 	h = MIN(src_h, dst_h);
 
