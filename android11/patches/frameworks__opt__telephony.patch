+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ */
+package com.android.internal.telephony.dataconnection;
+
+import java.text.Normalizer;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.function.Function;
+
+/**
+ * Locale-independent and operator-independent APN ordering hint.
+ *
+ * Only moves APNs already admitted by the Android MCC/MNC, MVNO, APN-type,
+ * network-type, and APN-set gates. Does not select an APN by numerical MCC/MNC
+ * alone, does not replace a user's preferred APN, does not delete fallback
+ * APNs and does not change the SIM or radio firmware.
+ */
+final class CarrierApnPriority {
+    private CarrierApnPriority() {}
+
+    private static String fold(String text) {
+        return text == null ? "" : Normalizer.normalize(text.trim(), Normalizer.Form.NFKC)
+                .toLowerCase(Locale.ROOT);
+    }
+
+    static boolean matchesBrand(String entryName, String simSpn) {
+        final String spn = fold(simSpn);
+        final String name = fold(entryName);
+        if (spn.length() < 2 || name.length() < spn.length() || !name.startsWith(spn)) {
+            return false;
+        }
+        // Do not match "Claro" against a different provider "ClaroNet";
+        // allow suffixes such as "Claro Internet", "Plus-MMS", "O2 (data)".
+        if (name.length() == spn.length()) return true;
+        final char boundary = name.charAt(spn.length());
+        return Character.isWhitespace(boundary) || boundary == '-' || boundary == '('
+                || boundary == '[' || boundary == '/' || boundary == ':';
+    }
+
+    static <T> boolean moveBrandMatchesFirst(List<T> apns, String simSpn,
+            Function<T, String> entryName) {
+        if (apns == null || apns.size() < 2 || fold(simSpn).length() < 2) {
+            return false;
+        }
+        final ArrayList<T> matched = new ArrayList<>();
+        final ArrayList<T> other = new ArrayList<>();
+        for (T apn : apns) {
+            (matchesBrand(entryName.apply(apn), simSpn) ? matched : other).add(apn);
+        }
+        if (matched.isEmpty() || other.isEmpty()) return false;
+        // Stable partition: preserve the relative order and stock failovers
+        // inside both groups, never persist an APN preference before success.
+        apns.clear();
+        apns.addAll(matched);
+        apns.addAll(other);
+        return true;
+    }
+}
