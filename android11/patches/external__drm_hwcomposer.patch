index 0000000000000000000000000000000000000000..74f1d72d18047e9693d0a7ebda275aea52287818
--- /dev/null
+++ b/tests/g1592_t311_zaware_policy_test.cpp
@@ -0,0 +1,26 @@
+// SM-T311 host unit regression of the board-guarded 3-FIMD-plane opt-in.
+#include "t311_zaware_policy.h"
+#include <assert.h>
+#include <stdio.h>
+
+int main() {
+  int accepted = 0;
+  for (int mask = 0; mask < 1024; ++mask) {
+    android::T311ZawareCase c = {
+        !!(mask & (1 << 0)), !!(mask & (1 << 1)),
+        !!(mask & (1 << 2)), !!(mask & (1 << 3)),
+        !!(mask & (1 << 4)), !!(mask & (1 << 5)),
+        !!(mask & (1 << 6)), !!(mask & (1 << 7)),
+        !!(mask & (1 << 8)), !!(mask & (1 << 9))};
+    const bool result = android::T311AllowWin1Win2Win3(c);
+    assert(result == (mask == 1023));
+    if (result) ++accepted;
+  }
+  assert(accepted == 1);
+  // The existing runtime property defaults to 0 even when device and
+  // all capabilities pass: accepted case must be opt-in.
+  android::T311ZawareCase off = {
+      true, false, true, true, true, true, true, true, true, true};
+  assert(!android::T311AllowWin1Win2Win3(off));
+  puts("G1592_SM_T311_WIN1_WIN2_WIN3_STRICT_1024_NEGATIVE_PLUS_OPTIN_TEST_PASS");
+}
