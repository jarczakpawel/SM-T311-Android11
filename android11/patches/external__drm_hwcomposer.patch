+static int ValidateFramePlaneBindings(
+    const std::vector<DrmHwcLayer> &layers,
+    const std::vector<DrmCompositionPlane> &planes) {
+  std::vector<uint8_t> assigned(layers.size(), 0);
+  size_t assigned_count = 0;
+  for (const auto &plane : planes) {
+    if (!plane.plane() || !plane.crtc()) {
+      ALOGE("DRM composition has a null plane or CRTC");
+      return -EINVAL;
+    }
+    if (plane.type() == DrmCompositionPlane::Type::kDisable)
+      continue;
+    const auto &sources = plane.source_layers();
+    if (sources.size() != 1 || sources.front() >= layers.size()) {
+      ALOGE("DRM composition has %zu source layers (frame has %zu)",
+            sources.size(), layers.size());
+      return -EINVAL;
+    }
+    const size_t index = sources.front();
+    if (!layers[index].buffer || assigned[index]) {
+      ALOGE("DRM composition references missing or repeated layer %zu", index);
+      return -EINVAL;
+    }
+    assigned[index] = 1;
+    ++assigned_count;
+  }
+  if (assigned_count != layers.size()) {
+    ALOGE("DRM composition maps %zu/%zu layers; refusing partial frame",
+          assigned_count, layers.size());
+    return -ENOSPC;
+  }
+  return 0;
+}
