+// SPDX-License-Identifier: Apache-2.0
+// Source-only SM-T311 immutable FIMD z-aware underlay policy.
+// This structure is independent of Android to permit host-side exhaustive tests.
+#ifndef T311_ZAWARE_POLICY_H_
+#define T311_ZAWARE_POLICY_H_
+namespace android {
+struct T311ZawareCase {
+  bool is_lt013g;
+  bool opt_in;
+  bool three_device_layers;
+  bool supported_win1_overlay;
+  bool supported_win2_primary;
+  bool supported_win3_overlay;
+  bool bottom_fullscreen_opaque;
+  bool middle_partial_opaque;
+  bool top_non_scaling_buffer;
+  bool all_unprotected;
+};
+inline bool T311AllowWin1Win2Win3(const T311ZawareCase &p) {
+  return p.is_lt013g && p.opt_in && p.three_device_layers &&
+         p.supported_win1_overlay && p.supported_win2_primary &&
+         p.supported_win3_overlay && p.bottom_fullscreen_opaque &&
+         p.middle_partial_opaque && p.top_non_scaling_buffer &&
+         p.all_unprotected;
+}
+}  // namespace android
+#endif  // T311_ZAWARE_POLICY_H_
