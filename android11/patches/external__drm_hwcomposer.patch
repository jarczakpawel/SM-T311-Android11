+float DrmMode::hwc_reported_v_refresh() const {
+  // SM-T311: the working FIMD divider produces 58.455Hz on the LCD,
+  // but the kernel's known-good DRM mode retains the nominal 72161kHz
+  // for the hardware CLKVAL_F calculation (roughly 58.000Hz).
+  // Correct ONLY the HWC-reported rate, and the synthetic-VSYNC fallback.
+  // Never modify DRM mode.clock or the actual FIMD/DSI scanout timing.
+  if (clock_ == 72161 && h_display_ == 800 && v_display_ == 1280 &&
+      h_total_ == 960 && v_total_ == 1296) {
+    static const bool is_t311 = [] {
+      char device[PROPERTY_VALUE_MAX];
+      property_get("ro.product.device", device, "");
+      return std::strcmp(device, "lt013g") == 0;
+    }();
+    if (is_t311)
+      return 72727.0f * 1000.0f / (v_total_ * h_total_);
+  }
+
+  // All other devices/modes retain their DRM-provided refresh rate.
+  return v_refresh();
+}
+
 uint32_t DrmMode::flags() const {
   return flags_;
 }
