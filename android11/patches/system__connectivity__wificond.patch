+TEST(NL80211AttributeTest, NestedFlagIsNotPartOfAttributeId) {
+  // Linux kernel nla_nest_start() sets NLA_F_NESTED in the wire type.
+  // G754: the Android 11 parser previously failed to find STA_INFO at all.
+  NL80211NestedAttr station_info(NL80211_ATTR_STA_INFO | NLA_F_NESTED);
+  station_info.AddAttribute(NL80211Attr<uint8_t>(
+      NL80211_STA_INFO_SIGNAL, static_cast<uint8_t>(-54)));
+  EXPECT_EQ(NL80211_ATTR_STA_INFO, station_info.GetAttributeId());
+
+  NL80211NestedAttr top_level(0);
+  top_level.AddAttribute(station_info);
+  EXPECT_TRUE(top_level.HasAttribute(NL80211_ATTR_STA_INFO));
+  NL80211NestedAttr decoded(0);
+  ASSERT_TRUE(top_level.GetAttribute(NL80211_ATTR_STA_INFO, &decoded));
+  uint8_t signal = 0;
+  ASSERT_TRUE(decoded.GetAttributeValue(NL80211_STA_INFO_SIGNAL, &signal));
+  EXPECT_EQ(static_cast<uint8_t>(-54), signal);
+}
+
+TEST(NL80211AttributeTest, RejectZeroLengthNestedAttribute) {
+  // Reject malformed attrs; otherwise GetAttributeImpl loops forever.
+  const std::vector<uint8_t> bad = {8, 0, 1, 0, 0, 0, 1, 0};
+  NL80211NestedAttr top_level(bad);
+  EXPECT_FALSE(top_level.HasAttribute(1));
+}
