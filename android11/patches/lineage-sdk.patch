     private boolean isSupportedHIDL(int feature) {
+        // SM-T311 has no vendor.lineage HIDL implementations. Repeated optional
+        // getService(true) probes issue futile ctl.interface_start requests at
+        // boot. Keep the working LineageHardwareService software fallback.
+        if ("lt013g".equals(Build.DEVICE)) {
+            return false;
+        }
         if (!mHIDLMap.containsKey(feature)) {
             mHIDLMap.put(feature, getHIDLService(feature));
         }
