--- a/init/reboot.cpp
+++ b/init/reboot.cpp
@@ -83,6 +83,43 @@ namespace init {
 
 static bool shutting_down = false;
 
+// G471: a bounded, opt-in-by-device shutdown trace for the SM-T311 only.
+// /dev/pmsg0 persists separately from logd, which Android kills *before*
+// the final sync/umount. On hardware hard reset the RAM may still be lost;
+// never treat a missing marker as proof that this point was not reached.
+// PMSG is a kernel character device; the bounded /cache record preserves
+// early phases on eMMC without altering the reboot target or services.
+static void TraceT311RecoveryShutdown(const char* phase, const std::string& target) {
+    if (target != "recovery" ||
+        android::base::GetProperty("ro.product.device", "") != "lt013g") return;
+    char msg[96];
+    int len = snprintf(msg, sizeof(msg), "T311_G471_INIT_SHUTDOWN phase=%s\n", phase);
+    if (len <= 0 || len >= static_cast<int>(sizeof(msg))) return;
+    auto fd = unique_fd(TEMP_FAILURE_RETRY(open("/dev/pmsg0",
+                O_WRONLY | O_NONBLOCK | O_CLOEXEC | O_NOFOLLOW)));
+    if (fd.ok()) {
+        // Best effort, constant-size one-shot write; never wait for a log.
+        (void)TEMP_FAILURE_RETRY(write(fd.get(), msg, len));
+    }
+    if (phase[0] != '0' || phase[1] > '5') return;
+    std::string boot_id;
+    if (!android::base::ReadFileToString("/proc/sys/kernel/random/boot_id", &boot_id)) return;
+    if (!boot_id.empty() && boot_id.back() == '\n') boot_id.pop_back();
+    if (boot_id.size() != 36 ||
+        boot_id.find_first_not_of("0123456789abcdef-") != std::string::npos) return;
+    auto dir = unique_fd(open("/cache/smt311-reboot-trace", O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+    if (!dir.ok()) return;
+    auto trace = unique_fd(openat(dir.get(), (boot_id + ".log").c_str(),
+                      O_WRONLY | O_APPEND | O_CREAT | O_CLOEXEC | O_NOFOLLOW, 0640));
+    if (!trace.ok()) return;
+    struct stat st;
+    if (fstat(trace.get(), &st) || !S_ISREG(st.st_mode) || st.st_size > 4096) return;
+    if (TEMP_FAILURE_RETRY(write(trace.get(), msg, len)) != len) return;
+    if (phase[1] == '0' || phase[1] == '3' || phase[1] == '5')
+        (void)fdatasync(trace.get());
+    if (phase[1] == '0') (void)fsync(dir.get());
+}
+
