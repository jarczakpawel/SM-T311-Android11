diff --git a/tests/mq_test.cpp b/tests/mq_test.cpp
index 96528d3424fc2c5cc5142b7d57c6708d59865ba6..f1cab0fcb4c04f9d3e13416fcbb6ba1154f469e1 100644
--- a/tests/mq_test.cpp
+++ b/tests/mq_test.cpp
@@ -313,6 +313,23 @@ TEST_F(QueueSizeOdd, EventFlagTest) {
     ASSERT_TRUE(ret);
 }
 
+TEST_F(BadQueueConfig, DescriptorWithoutEventFlagGrantor) {
+    MessageQueueSync producer(32, false);
+    ASSERT_TRUE(producer.isValid());
+    ASSERT_EQ(nullptr, producer.getEventFlagWord());
+    ASSERT_NE(nullptr, producer.getDesc());
+
+    MessageQueueSync consumer(*producer.getDesc(), false);
+    ASSERT_TRUE(consumer.isValid());
+    ASSERT_EQ(nullptr, consumer.getEventFlagWord());
+
+    const uint8_t sent[] = {1, 2, 3, 4};
+    uint8_t received[sizeof(sent)] = {};
+    ASSERT_TRUE(producer.write(sent, sizeof(sent)));
+    ASSERT_TRUE(consumer.read(received, sizeof(received)));
+    ASSERT_EQ(0, memcmp(sent, received, sizeof(sent)));
+}
+
 /*
  * Verify that a few bytes of data can be successfully written and read.
  */
