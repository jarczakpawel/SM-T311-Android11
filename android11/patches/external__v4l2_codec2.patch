@@ -0,0 +1,141 @@
+#!/usr/bin/env python3
+"""G1261 validate real Codec2 STOP ioctl failure before DRAINING transition.
+
+Host-only: extract exact failure branch from compiled production source, run
+native C++17 UBSan failure/success states, reject unsafe mutations. No media.
+"""
+from pathlib import Path
+import subprocess
+import tempfile
+
+SRC=Path(__file__).resolve().parents[1]/"components/V4L2EncodeComponent.cpp"
+GUARD="""if (mDevice->Ioctl(VIDIOC_ENCODER_CMD, &cmd) != 0) {
+        ALOGE("Failed to stop encoder");
+        // G1261: onDrainDone() asserts that DRAINING has already begun.
+        // STOP failed before that transition, so report the device failure
+        // directly instead of invoking a callback with an invalid state.
+        reportError(C2_CORRUPTED);
+        return;
+    }"""
+def check(src):
+    a=src.index("void V4L2EncodeComponent::drain()")
+    b=src.index("void V4L2EncodeComponent::flush()",a)
+    drain=src[a:b]
+    if drain.count(GUARD)!=1:
+        raise AssertionError("exact fatal STOP error branch absent or duplicated")
+    if not (drain.index("if (mEncoderState == EncoderState::DRAINING") <
+            drain.index(GUARD) <
+            drain.index("setEncoderState(EncoderState::DRAINING);")):
+        raise AssertionError("STOP rejection must be checked before state transition")
+    if "onDrainDone(false)" in drain:
+        raise AssertionError("illegal onDrainDone callback before DRAINING")
+    a=src.index("void V4L2EncodeComponent::onDrainDone(bool done)")
+    b=src.index("void V4L2EncodeComponent::flushTask(",a)
+    assert "ALOG_ASSERT(mEncoderState == EncoderState::DRAINING || mEncoderState == EncoderState::ERROR);" in src[a:b]
+    a=src.index("void V4L2EncodeComponent::reportError(")
+    b=src.index("void V4L2EncodeComponent::setComponentState(",a)
+    if "setEncoderState(EncoderState::ERROR)" not in src[a:b]:
+        raise AssertionError("no component error transition")
+    return GUARD
+
+def run_native(guard):
+    code=r"""
+#include <cassert>
+#include <cstdio>
+enum class EncoderState { ENCODING, WAITING_FOR_INPUT, DRAINING, ERROR };
+static EncoderState mEncoderState;
+static int ioctlCalls, errorCount, drainCallbacks, successfulDrainTransitions;
+static bool stopOK;
+static const int VIDIOC_ENCODER_CMD=100;
+static const int V4L2_ENC_CMD_STOP=1;
+static const int C2_CORRUPTED=66;
+struct EncoderCmd { int cmd; };
+struct FakeDevice {
+    int Ioctl(int, EncoderCmd *c) {
+        assert(c && c->cmd==V4L2_ENC_CMD_STOP);
+        ++ioctlCalls;
+        return stopOK ? 0 : -1;
+    }
+} dev, *mDevice=&dev;
+#define ALOGE(...) do {} while(false)
+static void reportError(int e) {
+    assert(e==C2_CORRUPTED);
+    ++errorCount;
+    mEncoderState=EncoderState::ERROR;
+}
+[[maybe_unused]] static void onDrainDone(bool) {
+    ++drainCallbacks;
+    assert(mEncoderState==EncoderState::DRAINING ||
+           mEncoderState==EncoderState::ERROR);
+}
+static void setEncoderState(EncoderState s) {
+    assert(s==EncoderState::DRAINING);
+    ++successfulDrainTransitions; mEncoderState=s;
+}
+static void drain() {
+    if (mEncoderState==EncoderState::DRAINING ||
+        mEncoderState==EncoderState::ERROR) return;
+    EncoderCmd cmd{V4L2_ENC_CMD_STOP};
+""" + guard + r"""
+    setEncoderState(EncoderState::DRAINING);
+}
+static void reset(EncoderState initial, bool ok) {
+    mEncoderState=initial;
+    stopOK=ok;
+    ioctlCalls=errorCount=drainCallbacks=successfulDrainTransitions=0;
+}
+int main() {
+    reset(EncoderState::ENCODING,false);
+    drain();
+    assert(mEncoderState==EncoderState::ERROR &&
+           errorCount==1 && drainCallbacks==0 &&
+           ioctlCalls==1 && successfulDrainTransitions==0);
+
+    reset(EncoderState::WAITING_FOR_INPUT,false);
+    drain();
+    assert(mEncoderState==EncoderState::ERROR &&
+           errorCount==1 && drainCallbacks==0 &&
+           ioctlCalls==1 && successfulDrainTransitions==0);
+
+    reset(EncoderState::ENCODING,true);
+    drain();
+    assert(mEncoderState==EncoderState::DRAINING &&
+           errorCount==0 && drainCallbacks==0 &&
+           ioctlCalls==1 && successfulDrainTransitions==1);
+
+    reset(EncoderState::DRAINING,false);
+    drain();
+    assert(mEncoderState==EncoderState::DRAINING &&
+           errorCount==0 && ioctlCalls==0);
+
+    reset(EncoderState::ERROR,false);
+    drain();
+    assert(mEncoderState==EncoderState::ERROR &&
+           errorCount==0 && ioctlCalls==0);
+
+    std::puts("PASS G1261_REAL_STOP_BRANCH_NATIVE_CPP_5_STATES_UBSAN");
+}
+"""
+    with tempfile.TemporaryDirectory(prefix="g1261-") as td:
+        source=Path(td)/"stop.cpp";binary=Path(td)/"stop"
+        source.write_text(code)
+        subprocess.run(["g++","-std=c++17","-O1","-Wall","-Wextra",
+                        "-Werror","-D_GLIBCXX_ASSERTIONS","-fsanitize=undefined",
+                        "-fno-sanitize-recover=all",str(source),"-o",str(binary)],check=True)
+        subprocess.run([str(binary)],check=True)
+def main():
+    s=SRC.read_text()
+    run_native(check(s))
+    for bad in [
+        s.replace(GUARD,GUARD.replace("reportError(C2_CORRUPTED);","onDrainDone(false);"),1),
+        s.replace(GUARD,GUARD.replace("return;",""),1),
+        s.replace(GUARD,GUARD.replace("reportError(C2_CORRUPTED);","setEncoderState(EncoderState::DRAINING);"),1),
+        s.replace(GUARD,GUARD.replace("!= 0","== 0"),1),
+        s.replace(GUARD,GUARD.replace("reportError(C2_CORRUPTED);",""),1),
+    ]:
+        try:check(bad)
+        except (AssertionError,ValueError):continue
+        raise AssertionError("unsafe STOP error handling accepted")
+    print("PASS G1261_REAL_STOP_BRANCH_FIVE_NEGATIVE_MUTATIONS_REFUSED")
+    print("G1261_HOST_ONLY_NO_AUDIO_VIDEO_CAMERA_MIC_GPS_MODEM_OR_FLASH")
+if __name__=="__main__":main()
