+guard = schedule.index("if (mEncoderState == EncoderState::DRAINING || mEncoderState == EncoderState::ERROR)")
+waiting = schedule.index("setEncoderState(EncoderState::WAITING_FOR_INPUT)")
+post = schedule.index("PostTask(", guard)
+assert eos < guard < waiting < post
+assert schedule.count("mEncoderState == EncoderState::ERROR") == 3
+assert "if (mEncoderState == EncoderState::ERROR)" in schedule[:eos]
