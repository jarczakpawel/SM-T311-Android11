+task = source.split("void V4L2EncodeComponent::queueTask(", 1)[1].split(
+    "void V4L2EncodeComponent::drainTask(", 1)[0]
+schedule = source.split("void V4L2EncodeComponent::scheduleNextEncodeTask()", 1)[1].split(
+    "bool V4L2EncodeComponent::encode(", 1)[0]
+assert "work->worklets.size() != 1u" in task
+assert "work->input.buffers.size() > 1u" in task
+assert "!work->input.buffers.front()" in task
+assert "work->input.buffers.front()->data().graphicBlocks().size() != 1u" in task
+assert task.index("const bool invalidWork") < task.index("mInputWorkQueue.push(std::move(work));")
+error = task.split("if (invalidWork) {", 1)[1].split("mInputWorkQueue.push(std::move(work));", 1)[0]
+for term in ("work->result = C2_CORRUPTED;", "work->input.buffers.clear();",
+             "onWorkDone_nb(shared_from_this(), std::move(failedWorks));", "return;"):
+    assert term in error
+assert "work->worklets.front()->output.flags" in schedule
+assert "data().graphicBlocks().front()" in schedule
+print("G1370_ENCODER_MALFORMED_INPUT_COMPLETION_SOURCE_PASS")
