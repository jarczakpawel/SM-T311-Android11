diff --git a/tests/test_g1196_mfc_buffer_ownership.py b/tests/test_g1196_mfc_buffer_ownership.py
new file mode 100644
index 0000000000000000000000000000000000000000..66ea4a7128317e6eceea6d149dff44737134b749
--- /dev/null
+++ b/tests/test_g1196_mfc_buffer_ownership.py
@@ -0,0 +1,132 @@
+#!/usr/bin/env python3
+"""G1196: test actual source-extracted encoder slot guards against invalid IDs.
+
+Runs only host-generated tiny C++ contracts; it DOES NOT call camera,
+microphone, recorder, kernel MFC, or modify the physical tablet.
+"""
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+SOURCE = Path(__file__).resolve().parents[1] / "components/V4L2EncodeComponent.cpp"
+FUNCTIONS = [
+    ("enqueueInputBuffer", "mInputBuffersMap", "mInputBuffersMap[bufferId].second", True),
+    ("enqueueOutputBuffer", "mOutputBuffersMap", "mOutputBuffersMap[bufferId]", True),
+    ("dequeueInputBuffer", "mInputBuffersMap", "mInputBuffersMap[bufferId].second", False),
+    ("dequeueOutputBuffer", "mOutputBuffersMap", "mOutputBuffersMap[bufferId]", False),
+]
+
+
+def extract_guards(source):
+    guards = []
+    for name, vector, owner, busy_fails in FUNCTIONS:
+        start = re.search(r"bool V4L2EncodeComponent::" + name + r"\(", source)
+        if start is None:
+            raise AssertionError("missing real C2 function: " + name)
+        body = source[start.end():]
+        nextfn = body.find("\nbool V4L2EncodeComponent::")
+        if nextfn >= 0:
+            body = body[:nextfn]
+        want = (f"bufferId >= {vector}.size() || " +
+                ("" if busy_fails else "!") + owner)
+        if body.count(want) != 1:
+            raise AssertionError("missing single bound/owner invariant " + name)
+        idx = body.index(want)
+        if body.rfind("const size_t bufferId = buffer->BufferId();", 0, idx) == -1 and (
+                body.rfind("size_t bufferId = buffer->BufferId();", 0, idx) == -1):
+            raise AssertionError("BufferId not declared before guard: " + name)
+        follow = body[idx:idx + 280]
+        if "reportError(C2_CORRUPTED)" not in follow or "return false;" not in follow:
+            raise AssertionError("missing fail-closed C2 corrupted branch " + name)
+        first_use = body.index(owner)
+        if first_use < idx and body[first_use:first_use + len(owner)] == owner:
+            # owner appears at the beginning of guard itself: that's expected.
+            raise AssertionError("slot access before guard: " + name)
+        guards.append(want)
+    return guards
+
+
+def compile_and_test(expressions, mutation=False):
+    # Expression text comes from the actual C2 source under test, not
+    # separately authored helper code: runtime assertions exercise exactly
+    # the source's short-circuit bound and owner checks.
+    methods = []
+    for i, exp in enumerate(expressions):
+        methods.append(f"""
+bool guard{i}(size_t bufferId, const std::vector<std::pair<long long,
+                std::unique_ptr<int>>>& mInputBuffersMap,
+                 const std::vector<std::shared_ptr<int>>& mOutputBuffersMap) {{
+    return {exp};
+}}
+""")
+    cpp = """
+#include <cstddef>
+#include <memory>
+#include <vector>
+#include <cassert>
+#include <cstdio>
+""" + "\n".join(methods) + """
+int main() {
+    std::vector<std::pair<long long, std::unique_ptr<int>>> mInputBuffersMap(3);
+    std::vector<std::shared_ptr<int>> mOutputBuffersMap(3);
+    for (size_t id : {size_t(3), size_t(999999), size_t(-1)}) {
+        assert(guard0(id, mInputBuffersMap, mOutputBuffersMap));
+        assert(guard1(id, mInputBuffersMap, mOutputBuffersMap));
+        assert(guard2(id, mInputBuffersMap, mOutputBuffersMap));
+        assert(guard3(id, mInputBuffersMap, mOutputBuffersMap));
+    }
+    assert(!guard0(0, mInputBuffersMap, mOutputBuffersMap));
+    assert(!guard1(0, mInputBuffersMap, mOutputBuffersMap));
+    assert(guard2(0, mInputBuffersMap, mOutputBuffersMap));
+    assert(guard3(0, mInputBuffersMap, mOutputBuffersMap));
+    mInputBuffersMap[0].second = std::make_unique<int>(1);
+    mOutputBuffersMap[0] = std::make_shared<int>(1);
+    assert(guard0(0, mInputBuffersMap, mOutputBuffersMap));
+    assert(guard1(0, mInputBuffersMap, mOutputBuffersMap));
+    assert(!guard2(0, mInputBuffersMap, mOutputBuffersMap));
+    assert(!guard3(0, mInputBuffersMap, mOutputBuffersMap));
+    assert(!guard0(1, mInputBuffersMap, mOutputBuffersMap));
+    assert(!guard1(1, mInputBuffersMap, mOutputBuffersMap));
+    assert(guard2(1, mInputBuffersMap, mOutputBuffersMap));
+    assert(guard3(1, mInputBuffersMap, mOutputBuffersMap));
+    std::puts("G1196_REAL_CPP_GUARD_BOUNDS_AND_OWNERSHIP_PASS");
+}
+"""
+    with tempfile.TemporaryDirectory(prefix="g1196-guard-host-") as td:
+        path = Path(td)
+        (path / "guards.cpp").write_text(cpp)
+        result = subprocess.run(
+            ["g++", "-std=c++17", "-D_GLIBCXX_ASSERTIONS", "-Wall",
+             "-Wextra", "-Wno-unused-parameter", "-Werror", "-o", str(path / "test"),
+             str(path / "guards.cpp")],
+            capture_output=True, text=True)
+        if result.returncode:
+            raise AssertionError("real guard unit C++ compilation failed: " + result.stderr[:1200])
+        run = subprocess.run([str(path / "test")], capture_output=True, text=True)
+        if mutation:
+            if run.returncode == 0:
+                raise AssertionError("out-of-bounds mutation incorrectly passed")
+        else:
+            if run.returncode != 0:
+                raise AssertionError("real guard rejected/segfaulted: " + run.stderr[:700])
+            print(run.stdout.strip())
+
+
+def main():
+    source = SOURCE.read_text()
+    guards = extract_guards(source)
+    compile_and_test(guards)
+    changed = list(guards)
+    changed[0] = changed[0].replace(" >= ", " > ", 1)
+    compile_and_test(changed, mutation=True)
+    changed = list(guards)
+    changed[3] = changed[3].replace(" >= ", " > ", 1)
+    compile_and_test(changed, mutation=True)
+    print("PASS G1196_FOUR_REAL_ENCODER_GUARDS_AND_TWO_FAILCLOSED_INDEX_MUTANTS")
+    print("G1196_HOST_ONLY_NO_H264_FUNCTIONAL_P128_CURE_CLAIM")
+
+
+if __name__ == "__main__":
+    main()
