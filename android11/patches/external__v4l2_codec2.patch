+bool V4L2Decoder::convertWithFimc(size_t bufferId, VideoFrame* frame) {
+    if (!mFimcFd.is_valid() || bufferId >= mOutputDmabufs.size() || !frame) return false;
+    const auto& srcFds = mOutputDmabufs[bufferId];
+    const auto& srcSizes = mOutputPlaneSizes[bufferId];
+    const auto& dstFds = frame->getFDs();
+    if (srcFds.size() < 2 || srcSizes.size() < 2 || dstFds.empty()) {
+        ALOGE("Q29O invalid FIMC planes src=%zu dstfds=%zu", srcFds.size(), dstFds.size());
+        return false;
+    }
+
+    struct v4l2_buffer cap = {};
+    struct v4l2_plane capPlanes[VIDEO_MAX_PLANES] = {};
+    cap.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+    cap.memory = V4L2_MEMORY_DMABUF;
+    cap.index = 0;
+    cap.length = 1;
+    cap.m.planes = capPlanes;
+    capPlanes[0].m.fd = dstFds[0];
+    capPlanes[0].length = mFimcCaptureFormat.fmt.pix_mp.plane_fmt[0].sizeimage;
+    if (mFimcFrameCount == 0) {
+        ALOGI("Q29O_FIMC_SINGLE_DMABUF dstfds=%zu fd0=%d length=%u", dstFds.size(),
+              dstFds[0], capPlanes[0].length);
+    }
+    if (xioctl(mFimcFd.get(), VIDIOC_QBUF, &cap) != 0) return false;
+
+    struct v4l2_buffer out = {};
+    struct v4l2_plane outPlanes[VIDEO_MAX_PLANES] = {};
+    out.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+    out.memory = V4L2_MEMORY_DMABUF;
+    out.index = 0;
+    out.length = 2;
+    out.m.planes = outPlanes;
+    for (size_t i = 0; i < 2; ++i) {
+        outPlanes[i].m.fd = srcFds[i].get();
+        outPlanes[i].length = srcSizes[i];
+        outPlanes[i].bytesused = srcSizes[i];
+    }
+    if (xioctl(mFimcFd.get(), VIDIOC_QBUF, &out) != 0) return false;
+
+    if (!mFimcStreaming) {
+        enum v4l2_buf_type capType = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+        enum v4l2_buf_type outType = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+        if (xioctl(mFimcFd.get(), VIDIOC_STREAMON, &capType) != 0) return false;
+        if (xioctl(mFimcFd.get(), VIDIOC_STREAMON, &outType) != 0) {
+            xioctl(mFimcFd.get(), VIDIOC_STREAMOFF, &capType);
+            return false;
+        }
+        mFimcStreaming = true;
+    }
+
+    bool capDone = false;
+    bool outDone = false;
+    int elapsed = 0;
+    while ((!capDone || !outDone) && elapsed < kFimcTimeoutMs) {
+        if (!capDone) {
+            struct v4l2_buffer b = {};
+            struct v4l2_plane p[VIDEO_MAX_PLANES] = {};
+            b.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+            b.memory = V4L2_MEMORY_DMABUF;
+            b.length = VIDEO_MAX_PLANES;
+            b.m.planes = p;
+            if (xioctl(mFimcFd.get(), VIDIOC_DQBUF, &b) == 0) capDone = true;
+            else if (errno != EAGAIN) return false;
+        }
+        if (!outDone) {
+            struct v4l2_buffer b = {};
+            struct v4l2_plane p[VIDEO_MAX_PLANES] = {};
+            b.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+            b.memory = V4L2_MEMORY_DMABUF;
+            b.length = VIDEO_MAX_PLANES;
+            b.m.planes = p;
+            if (xioctl(mFimcFd.get(), VIDIOC_DQBUF, &b) == 0) outDone = true;
+            else if (errno != EAGAIN) return false;
+        }
+        if (!capDone || !outDone) {
+            struct pollfd pfd = {mFimcFd.get(), POLLIN | POLLOUT | POLLERR, 0};
+            int ret = poll(&pfd, 1, 10);
+            if (ret < 0 && errno != EINTR) return false;
+            elapsed += 10;
+        }
+    }
+    if (!capDone || !outDone) {
+        ALOGE("Q29 FIMC timeout cap=%d out=%d", capDone, outDone);
+        return false;
+    }
+
+    /*
+     * SMT311_Q29V_FIMC_FRAME_BARRIER_STREAMOFF:
+     * Q28B's bit-exact bridge completed each FIMC transaction with STREAMOFF
+     * before userspace consumed the destination. Keep the same hardware-idle
+     * boundary here. This is not a CPU cache flush and does not copy pixels.
+     */
+    {
+        enum v4l2_buf_type outType = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+        enum v4l2_buf_type capType = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+        if (xioctl(mFimcFd.get(), VIDIOC_STREAMOFF, &outType) != 0) {
+            ALOGE("Q29V FIMC STREAMOFF output failed: %s", strerror(errno));
+            return false;
+        }
+        if (xioctl(mFimcFd.get(), VIDIOC_STREAMOFF, &capType) != 0) {
+            ALOGE("Q29V FIMC STREAMOFF capture failed: %s", strerror(errno));
+            return false;
+        }
+        mFimcStreaming = false;
+        if (mFimcFrameCount == 0)
+            ALOGI("Q29V_FIMC_FRAME_BARRIER_STREAMOFF active");
+    }
+
+    ++mFimcFrameCount;
+    if (mFimcFrameCount == 1) {
+        ALOGI("Q29L_FIMC_ACTIVE first_buffer=%zu", bufferId);
+    }
+    ALOGV("Q29_FIMC_FRAME buffer=%zu count=%zu", bufferId, mFimcFrameCount);
+    return true;
+}
+
+void V4L2Decoder::recycleOutputBuffer(size_t bufferId) {
+    auto outputBuffer = mOutputQueue->GetFreeBuffer(bufferId);
+    if (!outputBuffer || !std::move(*outputBuffer).QueueMMap()) {
+        ALOGE("Q29 failed to recycle MFC buffer %zu", bufferId);
+        onError();
+    }
+}
