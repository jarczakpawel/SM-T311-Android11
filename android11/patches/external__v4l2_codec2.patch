@@ -0,0 +1,148 @@
+#!/usr/bin/env python3
+"""G1251 source-extracted fatal poll and input DQBUF propagation tests.
+
+Only compile tiny control-flow skeletons on Debian. Do not run Android media,
+camera, microphone, sound, H264 capture, or alter device configuration.
+"""
+from pathlib import Path
+import subprocess
+import tempfile
+
+CODE = Path(__file__).resolve().parents[1] / "components/V4L2EncodeComponent.cpp"
+POLL = """if (!startDevicePoll()) {
+            ALOGE("G1251_START_POLL_FAILED_ABORT_ENCODE");
+            return false;
+        }"""
+INPUT = """if (mEncoderState == EncoderState::ERROR) {
+        ALOGE("G1251_INPUT_DQBUF_ERROR_ABORT_CAPTURE_SERVICE");
+        return;
+    }"""
+
+def gate(source):
+    a = source.index("bool V4L2EncodeComponent::encode(")
+    b = source.index("void V4L2EncodeComponent::drain()", a)
+    encode = source[a:b]
+    a = source.index("void V4L2EncodeComponent::serviceDeviceTask(")
+    b = source.index("bool V4L2EncodeComponent::enqueueInputBuffer(", a)
+    service = source[a:b]
+    if encode.count(POLL) != 1 or service.count(INPUT) != 1:
+        raise AssertionError("G1251 missing/duplicated exact production guards")
+    if not (encode.index("mOutputQueue->Streamon()") <
+            encode.index(POLL) <
+            encode.index("while (mOutputQueue->FreeBuffersCount()")):
+        raise AssertionError("poll failure must abort BEFORE CAPTURE QBUF")
+    if not (service.index("while (mInputQueue->QueuedBuffersCount()") <
+            service.index(INPUT) <
+            service.index("while (mOutputQueue->QueuedBuffersCount()")):
+        raise AssertionError("input error must abort BEFORE CAPTURE DQBUF")
+    if "reportError(C2_CORRUPTED);" not in source[
+            source.index("bool V4L2EncodeComponent::startDevicePoll()"):
+            source.index("bool V4L2EncodeComponent::stopDevicePoll()")]:
+        raise AssertionError("poll failure would not notify Codec2")
+    if "reportError(C2_CORRUPTED);" not in source[
+            source.index("bool V4L2EncodeComponent::dequeueInputBuffer()"):
+            source.index("bool V4L2EncodeComponent::dequeueOutputBuffer()")]:
+        raise AssertionError("DQBUF failure would not notify Codec2")
+    return POLL, INPUT
+
+def native(guards):
+    poll, inp = guards
+    code = r"""
+#include <cassert>
+#include <cstdio>
+#define ALOGE(...) do {} while (false)
+enum class EncoderState { ENCODING, ERROR };
+static EncoderState mEncoderState;
+static int pollCalls, queueOutput, inputCalls, outputCalls;
+static bool pollOK, inputOK, inputPending, outputPending;
+static bool startDevicePoll() {
+    ++pollCalls;
+    if (!pollOK) { mEncoderState=EncoderState::ERROR; return false; }
+    return true;
+}
+static bool enqueueOutputBuffer() { ++queueOutput; return true; }
+static bool dequeueInputBuffer() {
+    ++inputCalls;
+    if (!inputOK) {
+        mEncoderState=EncoderState::ERROR;
+        return false;
+    }
+    return true;
+}
+static bool dequeueOutputBuffer() { ++outputCalls;return true; }
+static bool startAndQueue() {
+""" + poll + r"""
+    while (queueOutput < 1) if (!enqueueOutputBuffer()) return false;
+    return true;
+}
+static void serviceDeviceTask() {
+    if (mEncoderState == EncoderState::ERROR) return;
+    while (inputPending) {
+        inputPending = false;
+        if (!dequeueInputBuffer()) break;
+    }
+""" + inp + r"""
+    while (outputPending) {
+        outputPending = false;
+        if (!dequeueOutputBuffer()) break;
+    }
+}
+static void reset() {
+    mEncoderState=EncoderState::ENCODING;
+    pollCalls=queueOutput=inputCalls=outputCalls=0;
+    pollOK=inputOK=true;
+    inputPending=outputPending=false;
+}
+int main() {
+    reset(); assert(startAndQueue());
+    assert(pollCalls==1 && queueOutput==1);
+
+    reset(); pollOK=false;
+    assert(!startAndQueue());
+    assert(mEncoderState==EncoderState::ERROR && pollCalls==1 && queueOutput==0);
+
+    reset(); inputPending=outputPending=true; inputOK=false;
+    serviceDeviceTask();
+    assert(mEncoderState==EncoderState::ERROR && inputCalls==1 && outputCalls==0);
+
+    reset(); inputPending=outputPending=true;
+    serviceDeviceTask();
+    assert(inputCalls==1 && outputCalls==1 && mEncoderState==EncoderState::ENCODING);
+
+    reset(); inputPending=false;outputPending=true;
+    serviceDeviceTask();
+    assert(inputCalls==0 && outputCalls==1);
+
+    reset(); mEncoderState=EncoderState::ERROR;
+    inputPending=outputPending=true;
+    serviceDeviceTask();
+    assert(inputCalls==0 && outputCalls==0);
+
+    std::puts("PASS G1251_EXTRACTED_NATIVE_CPP_SIX_NORMAL_AND_ERROR_PATHS_UBSAN");
+}
+"""
+    with tempfile.TemporaryDirectory(prefix="g1251-test-") as temp:
+        path=Path(temp)/"g1251.cpp";bin=Path(temp)/"g1251"
+        path.write_text(code)
+        subprocess.run(["g++","-std=c++17","-O1","-Wall","-Wextra","-Werror",
+                        "-D_GLIBCXX_ASSERTIONS","-fsanitize=undefined",
+                        "-fno-sanitize-recover=all",str(path),"-o",str(bin)],check=True)
+        subprocess.run([str(bin)],check=True)
+
+def main():
+    text=CODE.read_text()
+    guards=gate(text)
+    native(guards)
+    variants=[
+      text.replace(POLL, "startDevicePoll();",1),
+      text.replace(INPUT, "",1),
+      text.replace(POLL,POLL.replace("return false;","return true;"),1),
+      text.replace(INPUT,INPUT.replace("return;","break;"),1),
+    ]
+    for i,bad in enumerate(variants):
+        try:gate(bad)
+        except (AssertionError, ValueError):continue
+        raise AssertionError(f"G1251 mutation {i} unexpectedly passed")
+    print("PASS G1251_SOURCE_GUARD_ORDER_FOUR_FATAL_MUTANTS_REJECTED")
+    print("G1251_HOST_ONLY_NO_VIDEO_AUDIO_MIC_CAMERA_MODEM_GPS_OR_FLASH")
+if __name__=="__main__":main()
