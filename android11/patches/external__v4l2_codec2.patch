+bool V4L2Decoder::exportOutputBuffers(size_t count, size_t numPlanes) {
+    mOutputDmabufs.clear();
+    mOutputPlaneSizes.clear();
+    mOutputDmabufs.resize(count);
+    mOutputPlaneSizes.resize(count);
+    for (size_t i = 0; i < count; ++i) {
+        struct v4l2_buffer query = {};
+        struct v4l2_plane planes[VIDEO_MAX_PLANES] = {};
+        query.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+        query.memory = V4L2_MEMORY_MMAP;
+        query.index = i;
+        query.length = VIDEO_MAX_PLANES;
+        query.m.planes = planes;
+        if (mDevice->Ioctl(VIDIOC_QUERYBUF, &query) != 0 || query.length != numPlanes) return false;
+        for (size_t p = 0; p < query.length; ++p) {
+            struct v4l2_exportbuffer exp = {};
+            exp.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+            exp.index = i;
+            exp.plane = p;
+            exp.flags = O_CLOEXEC;
+            if (mDevice->Ioctl(VIDIOC_EXPBUF, &exp) != 0) return false;
+            mOutputDmabufs[i].emplace_back(exp.fd);
+            mOutputPlaneSizes[i].push_back(planes[p].length);
+        }
+    }
+    return true;
+}
