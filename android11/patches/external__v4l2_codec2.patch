+
+SOURCE = Path(__file__).resolve().parents[1] / "components/V4L2EncodeComponent.cpp"
+
+CALLBACK_GUARD = """if (mEncoderState == EncoderState::ERROR) {
+            ALOGE("G1211_CAPTURE_HANDLER_REPORTED_ERROR");
+            return false;
+        }"""
+DRAIN_GUARD = """if (mEncoderState == EncoderState::ERROR) {
+            ALOGE("G1211_CAPTURE_DRAIN_REPORTED_ERROR");
+            return false;
+        }"""
+REQUEUE_GUARD = """if (!enqueueOutputBuffer()) {
+        ALOGE("G1211_CAPTURE_REQUEUE_FAILED");
+        return false;
+    }"""
+
+
+def extract(body: str) -> str:
+    a = body.index("bool V4L2EncodeComponent::dequeueOutputBuffer()")
+    b = body.index("\nbool V4L2EncodeComponent::createInputBuffers()", a)
+    return body[a:b]
+
+
+def verify(body: str):
+    part = extract(body)
+    for name, marker in (("callback", CALLBACK_GUARD), ("drain", DRAIN_GUARD),
+                         ("requeue", REQUEUE_GUARD)):
+        if part.count(marker) != 1:
+            raise AssertionError(f"G1211 missing or duplicated {name} guard")
+    callback = part.find("onOutputBufferDone(")
+    callback_guard = part.find(CALLBACK_GUARD)
+    drain = part.find("onDrainDone(true)")
+    drain_guard = part.find(DRAIN_GUARD)
+    restart = part.find("cmd.cmd = V4L2_ENC_CMD_START;")
+    requeue = part.find(REQUEUE_GUARD)
+    exit_ok = part.rfind("return true;")
+    if not (0 < callback < callback_guard < drain < drain_guard < restart < requeue < exit_ok):
+        raise AssertionError("G1211 invalid capture completion error ordering")
+    if part.count("enqueueOutputBuffer()") != 1:
+        raise AssertionError("G1211 unguarded secondary capture requeue call")
+    # Requeue happens only after last buffer reference is surrendered.
+    if part.find("buffer = nullptr;") > requeue:
+        raise AssertionError("G1211 capture reference was not released before requeue")
+    return CALLBACK_GUARD, DRAIN_GUARD, REQUEUE_GUARD
+
+
+def live_control_flow(guards):
+    callback_guard, drain_guard, requeue_guard = guards
+    # These three if/return blocks are pasted exactly from the actual C++
+    # production body: no copy of conditional expressions is rewritten here.
+    cpp = r"""
+#include <cassert>
+#include <cstdio>
+enum class EncoderState { ENCODING, DRAINING, ERROR };
+static EncoderState mEncoderState;
+static bool gCallbackFails;
+static bool gDrainFails;
+static bool gRequeueSucceeds;
+static int gRestarted;
+static int gQueued;
+#define ALOGE(...) do {} while (false)
+static bool enqueueOutputBuffer() { ++gQueued; return gRequeueSucceeds; }
+static void onOutputBufferDone() {
+    if (gCallbackFails) mEncoderState = EncoderState::ERROR;
+}
+static void onDrainDone(bool) {
+    if (gDrainFails) mEncoderState = EncoderState::ERROR;
+}
+static bool finish(bool hasPayload, bool finalBuffer) {
+    if (hasPayload) {
+        onOutputBufferDone();
+""" + callback_guard + r"""
+    }
+    if ((mEncoderState == EncoderState::DRAINING) && finalBuffer) {
+        onDrainDone(true);
+""" + drain_guard + r"""
+        ++gRestarted;
+    }
+""" + requeue_guard + r"""
+    return true;
+}
+int main() {
+    mEncoderState=EncoderState::ENCODING;
+    gCallbackFails=false;gDrainFails=false;gRequeueSucceeds=true;
+    gRestarted=0;gQueued=0;
+    assert(finish(true,false) && gRestarted==0 && gQueued==1);
+
+    mEncoderState=EncoderState::ENCODING;
+    gCallbackFails=true;gDrainFails=false;gRequeueSucceeds=true;
+    gRestarted=0;gQueued=0;
+    assert(!finish(true,false) && mEncoderState==EncoderState::ERROR
+           && gRestarted==0 && gQueued==0);
+
+    mEncoderState=EncoderState::DRAINING;
+    gCallbackFails=false;gDrainFails=true;gRequeueSucceeds=true;
+    gRestarted=0;gQueued=0;
+    assert(!finish(false,true) && mEncoderState==EncoderState::ERROR
+           && gRestarted==0 && gQueued==0);
+
+    mEncoderState=EncoderState::ENCODING;
+    gCallbackFails=false;gDrainFails=false;gRequeueSucceeds=false;
+    gRestarted=0;gQueued=0;
+    assert(!finish(true,false) && gQueued==1 && gRestarted==0);
+
+    mEncoderState=EncoderState::DRAINING;
+    gCallbackFails=false;gDrainFails=false;gRequeueSucceeds=true;
+    gRestarted=0;gQueued=0;
+    assert(finish(true,true) && gRestarted==1 && gQueued==1);
+    std::puts("PASS G1211_REAL_CAPTURE_GUARDS_HOST_CPP_NORMAL_CALLBACK_ERROR_DRAIN_ERROR_REQUEUE_ERROR");
+}
+"""
+    with tempfile.TemporaryDirectory(prefix="g1211-capture-") as td:
+        src = Path(td) / "guard_test.cpp"
+        binary = Path(td) / "guard_test"
+        src.write_text(cpp)
+        subprocess.run(["g++", "-std=c++17", "-O1", "-Wall", "-Wextra",
+                        "-Werror", "-D_GLIBCXX_ASSERTIONS", "-fsanitize=undefined",
+                        "-fno-sanitize-recover=all", str(src), "-o", str(binary)],
+                       check=True)
+        subprocess.run([str(binary)], check=True)
+
+
+def main():
+    body = SOURCE.read_text()
+    guards = verify(body)
+    live_control_flow(guards)
+    for original in guards:
+        bad = body.replace(original, "/* G1211 INTENTIONALLY REMOVED */", 1)
+        try:
+            verify(bad)
+        except AssertionError:
+            pass
+        else:
+            raise AssertionError("G1211 mutation incorrectly accepted: " + original)
+    print("PASS G1211_THREE_EXACT_SOURCE_GUARDS_AND_3_FAILCLOSED_MUTANTS")
+    print("G1211_NO_MEDIA_DEVICE_ACCESS_AND_NO_H264_CORRUPTION_CURE_CLAIM")
+
+if __name__ == "__main__":
+    main()
