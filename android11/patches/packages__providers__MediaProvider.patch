+struct SnapshotDeleter {
+    void operator()(sm_snapshot* s) const {
+        if (!s) return;
+        sm_snapshot_release(s);
+        delete s;
+    }
+};
+
+// The original lower fd stays under its existing handle; this helper returns
+// a separately sealed redacted view and a lifetime owner for the handle.
+// Fail closed on any truncation, parser, quota or sealing failure.
+static int make_private_redacted_snapshot(struct fuse* fuse, const string& path,
+                                          int lower_fd, uid_t uid, pid_t tid,
+                                          std::shared_ptr<void>* owner, int* clean_fd) {
+    std::unique_ptr<sm_snapshot, SnapshotDeleter> snapshot(new sm_snapshot());
+    sm_snapshot_init(snapshot.get());
+    const int capture = sm_snapshot_begin(snapshot.get(), lower_fd);
+    if (capture < 0) return -capture;
+
+    std::unique_ptr<RedactionInfo> frozen_ranges = fuse->mp->GetSnapshotRedactionInfo(
+            path, uid, tid, sm_snapshot_raw_fd(snapshot.get()));
+    if (!frozen_ranges || !frozen_ranges->isRedactionNeeded()) {
+        return EIO;
+    }
+    std::vector<ReadRange> pieces;
+    frozen_ranges->getReadRanges(0, snapshot->length, &pieces);
+    std::vector<sm_range> redactions;
+    for (const ReadRange& part : pieces) {
+        if (!part.is_redaction) continue;
+        if (part.start < 0 || !part.size ||
+            static_cast<uint64_t>(part.start) > snapshot->length ||
+            static_cast<uint64_t>(part.size) > snapshot->length -
+                static_cast<uint64_t>(part.start) ||
+            redactions.size() >= SM_SNAP_MAX_RANGES) {
+            return EIO;
+        }
+        redactions.push_back({static_cast<uint64_t>(part.start),
+                              static_cast<uint64_t>(part.start) + part.size});
+    }
+    if (redactions.empty()) return EIO;
+    const int result = sm_snapshot_finish(snapshot.get(), redactions.data(), redactions.size());
+    if (result < 0) return -result;
+    const int sealed_fd = sm_snapshot_clean_fd(snapshot.get());
+    if (sealed_fd < 0) return EIO;
+    // Own both the immutable fd and budget until node::DestroyHandle.
+    *owner = std::shared_ptr<void>(snapshot.release(), SnapshotDeleter());
+    *clean_fd = sealed_fd;
+    return 0;
+}
