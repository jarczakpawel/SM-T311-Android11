+static int open_passthrough_file(const struct fuse* fuse, const string& path, int flags,
+                                 mode_t create_mode = 0) {
+    const size_t root_len = fuse->path.size();
+    if (path.size() <= root_len + 1 || path.compare(0, root_len, fuse->path) != 0 ||
+        path[root_len] != '/') {
+        errno = EACCES;
+        return -1;
+    }
+
+    int parent = fuse->root_fd.get();
+    android::base::unique_fd directory;
+    size_t start = root_len + 1;
+    while (true) {
+        const size_t end = path.find('/', start);
+        const string component = path.substr(start, end - start);
+        if (component.empty() || component == "." || component == "..") {
+            errno = EACCES;
+            return -1;
+        }
+        if (end == string::npos) {
+            return openat(parent, component.c_str(), flags | O_NOFOLLOW | O_CLOEXEC,
+                          create_mode);
+        }
+        directory.reset(openat(parent, component.c_str(),
+                               O_PATH | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+        if (directory.get() < 0) return -1;
+        parent = directory.get();
+        start = end + 1;
+    }
+}
