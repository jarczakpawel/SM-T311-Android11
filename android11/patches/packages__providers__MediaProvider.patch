+ * lower path or fd, and fail closed if decoding metadata is unreliable. */
+int sm_snapshot_raw_fd(const struct sm_snapshot *s);
+/* Must call only after trusted parser created ranges from SAME sealed raw fd.
+ * On failure the session is released; never use raw fd as fallback.
+ * Rejects empty, malformed, unsorted, overlapping or out-of-bounds ranges. */
+int sm_snapshot_finish(struct sm_snapshot *s,
+                       const struct sm_range *ranges, size_t count);
+int sm_snapshot_clean_fd(const struct sm_snapshot *s);
+void sm_snapshot_release(struct sm_snapshot *s);
+uint64_t sm_snapshot_charged_total(void);
