+  unsigned char block[65536];
+  for (size_t at = 0; at < size;) {
+    size_t len = size - at < sizeof(block) ? size - at : sizeof(block);
+    rc = read_full(lower_fd, block, len, (off_t)at);
+    if (rc) { sm_snapshot_release(s); return rc; }
+    rc = write_full(s->raw_fd, block, len, (off_t)at);
+    if (rc) { sm_snapshot_release(s); return rc; }
+    at += len;
+  }
+  /* This rejects ordinary concurrent modification. Inode timestamps do
+   * NOT by themselves guarantee atomic capture under hostile writers.
+   * Always run a trusted metadata parser on this SEALED snapshot itself. */
+  if (fstat(lower_fd, &after)) {
+    rc = -errno; sm_snapshot_release(s); return rc;
+  }
+  if (!same_version(&before, &after)) {
+    sm_snapshot_release(s);
+    return -EAGAIN;
+  }
+  rc = seal_fd(s->raw_fd);
+  if (rc) { sm_snapshot_release(s); return rc; }
+  return 0;
+}
+int sm_snapshot_raw_fd(const struct sm_snapshot *s) {
+  return s ? s->raw_fd : -1;
+}
+int sm_snapshot_clean_fd(const struct sm_snapshot *s) {
+  return s ? s->clean_fd : -1;
+}
+static int validate(const struct sm_snapshot *s,
+                    const struct sm_range *ranges, size_t count) {
+  if (!s || s->raw_fd < 0 || s->clean_fd != -1 ||
+      !ranges || count == 0 || count > SM_SNAP_MAX_RANGES) return -EINVAL;
+  uint64_t last = 0;
+  for (size_t i = 0; i < count; ++i) {
+    if (ranges[i].start < last || ranges[i].start >= ranges[i].end ||
+        ranges[i].end > s->length) return -EINVAL;
+    last = ranges[i].end;
+  }
+  return 0;
+}
+int sm_snapshot_finish(struct sm_snapshot *s,
+                       const struct sm_range *ranges, size_t count) {
+  int rc = validate(s, ranges, count);
+  if (rc) {
+    if (s) sm_snapshot_release(s);
+    return rc;
+  }
+  s->clean_fd = sealed_memfd("sm-t311-redacted-immutable", s->length);
+  if (s->clean_fd < 0) {
+    rc = s->clean_fd; s->clean_fd = -1;
+    sm_snapshot_release(s);
+    return rc;
+  }
+  unsigned char block[65536];
+  size_t ri = 0;
+  for (size_t at = 0; at < s->length;) {
+    size_t len = s->length - at < sizeof(block) ? s->length - at : sizeof(block);
+    rc = read_full(s->raw_fd, block, len, (off_t)at);
+    if (rc) { sm_snapshot_release(s); return rc; }
+    const uint64_t end = (uint64_t)at + len;
+    while (ri < count && ranges[ri].end <= (uint64_t)at) ++ri;
+    for (size_t j = ri; j < count && ranges[j].start < end; ++j) {
+      const uint64_t a = ranges[j].start > at ? ranges[j].start : (uint64_t)at;
+      const uint64_t b = ranges[j].end < end ? ranges[j].end : end;
+      if (b > a) memset(block + (size_t)(a - at), 0, (size_t)(b - a));
+    }
+    rc = write_full(s->clean_fd, block, len, (off_t)at);
+    if (rc) { sm_snapshot_release(s); return rc; }
+    at += len;
+  }
+  rc = seal_fd(s->clean_fd);
+  if (rc) { sm_snapshot_release(s); return rc; }
+  close(s->raw_fd);
+  s->raw_fd = -1;
+  uncharge(s->length);
+  s->charged_bytes = s->length;
+  return 0;
+}
