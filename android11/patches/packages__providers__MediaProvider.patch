+struct sm_range { uint64_t start; uint64_t end; };
+struct sm_snapshot {
+  int raw_fd;       /* privileged PRIVATE sealed source; never app-visible */
+  int clean_fd;     /* privileged sealed zeroed output, FD borrowed by daemon */
+  size_t length;
+  uint64_t charged_bytes; /* held until sm_snapshot_release */
+};
+void sm_snapshot_init(struct sm_snapshot *s);
