index 0000000000000000000000000000000000000000..d23069717d9cf88e73c0d4007e2c2b1281827d61
--- /dev/null
+++ b/jni/snapshot-g150.c
@@ -0,0 +1,194 @@
+#define _GNU_SOURCE
+#include "snapshot-g150.h"
+#include <stdatomic.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/memfd.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+#include <string.h>
