+
+/* In-process limit covers every live sanitized handle plus any transient
+ * raw snapshot. Cross-process accounting still requires a service owner. */
+static _Atomic uint64_t g_charged = 0;
+
+static int reserve_bytes(uint64_t want) {
+  uint64_t old = atomic_load(&g_charged);
+  for (;;) {
+    if (old > SM_SNAP_MAX_ALL || want > SM_SNAP_MAX_ALL - old)
+      return -ENOMEM;
+    if (atomic_compare_exchange_weak(&g_charged, &old, old + want))
+      return 0;
+  }
+}
+static void uncharge(uint64_t amount) {
+  if (amount) atomic_fetch_sub(&g_charged, amount);
+}
+uint64_t sm_snapshot_charged_total(void) { return atomic_load(&g_charged); }
+
+void sm_snapshot_init(struct sm_snapshot *s) {
+  if (!s) return;
+  s->raw_fd = -1;
+  s->clean_fd = -1;
+  s->length = 0;
+  s->charged_bytes = 0;
+}
+void sm_snapshot_release(struct sm_snapshot *s) {
+  if (!s) return;
+  if (s->raw_fd >= 0) close(s->raw_fd);
+  if (s->clean_fd >= 0) close(s->clean_fd);
+  uncharge(s->charged_bytes);
+  sm_snapshot_init(s);
+}
+static int sealed_memfd(const char *name, size_t length) {
+  int fd = memfd_create(name, MFD_CLOEXEC | MFD_ALLOW_SEALING);
+  if (fd < 0) return -errno;
+  if (ftruncate(fd, (off_t)length)) {
+    int err = errno;
+    close(fd);
+    return -err;
+  }
+  return fd;
+}
+static int seal_fd(int fd) {
+  const int required = F_SEAL_WRITE | F_SEAL_GROW |
+                       F_SEAL_SHRINK | F_SEAL_SEAL;
+  if (fcntl(fd, F_ADD_SEALS, required) != 0) return -errno;
+  int seals = fcntl(fd, F_GET_SEALS);
+  if (seals < 0) return -errno;
+  return (seals & required) == required ? 0 : -EIO;
+}
+static int read_full(int fd, void *dst, size_t n, off_t off) {
+  unsigned char *p = dst;
+  while (n) {
+    ssize_t r = pread(fd, p, n, off);
+    if (r < 0 && errno == EINTR) continue;
+    if (r <= 0) return r == 0 ? -EIO : -errno;
+    off += r; p += r; n -= (size_t)r;
+  }
+  return 0;
+}
+static int write_full(int fd, const void *src, size_t n, off_t off) {
+  const unsigned char *p = src;
+  while (n) {
+    ssize_t r = pwrite(fd, p, n, off);
+    if (r < 0 && errno == EINTR) continue;
+    if (r <= 0) return r == 0 ? -EIO : -errno;
+    off += r; p += r; n -= (size_t)r;
+  }
+  return 0;
+}
+static bool same_version(const struct stat *a, const struct stat *b) {
+  return a->st_dev == b->st_dev && a->st_ino == b->st_ino &&
+         a->st_size == b->st_size &&
+         a->st_ctim.tv_sec == b->st_ctim.tv_sec &&
+         a->st_ctim.tv_nsec == b->st_ctim.tv_nsec &&
+         a->st_mtim.tv_sec == b->st_mtim.tv_sec &&
+         a->st_mtim.tv_nsec == b->st_mtim.tv_nsec;
+}
+int sm_snapshot_begin(struct sm_snapshot *s, int lower_fd) {
+  if (!s || lower_fd < 0) return -EINVAL;
+  if (s->raw_fd != -1 || s->clean_fd != -1 || s->charged_bytes)
+    return -EBUSY;
+  struct stat before, after;
+  if (fstat(lower_fd, &before)) return -errno;
+  if (!S_ISREG(before.st_mode)) return -EINVAL;
+  if (before.st_size <= 0 || (uint64_t)before.st_size > SM_SNAP_MAX_ONE)
+    return -EFBIG;
+  const size_t size = (size_t)before.st_size;
+  int rc = reserve_bytes((uint64_t)size * 2);
+  if (rc) return rc;
+  s->charged_bytes = (uint64_t)size * 2;
+  s->length = size;
+  s->raw_fd = sealed_memfd("sm-t311-private-raw", size);
+  if (s->raw_fd < 0) {
+    rc = s->raw_fd;
+    sm_snapshot_init(s); /* reset only AFTER releasing reservation below */
+    uncharge((uint64_t)size * 2);
+    return rc;
+  }
