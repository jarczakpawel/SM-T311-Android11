// Isolated, PRIVATE, real minigbm -> PRIME fd -> G2D & Lima import check.
cc_binary {
    name: "t311_g2d_prime_offline",
    vendor: true,
    srcs: ["main.c", "g2d_bridge.c"],
    static_libs: ["libt311_minigbm_exynos_prime_offline", "libexynos_g2d_t311_offline"],
    shared_libs: ["libdrm", "libcutils", "libnativewindow", "libsync", "liblog"],
    include_dirs: ["external/minigbm", "external/libdrm/exynos", "external/libdrm"],
    cflags: ["-Wall", "-Wextra", "-Werror", "-std=c11", "-O2"],
}
