// Isolated scratch BO fill verification; not installed into ROM.
cc_binary {
    name: "t311_g2d_scratch_offline",
    vendor: true,
    srcs: ["main.c"],
    shared_libs: ["libdrm"],
    static_libs: ["libexynos_g2d_t311_offline"],
    include_dirs: ["external/libdrm/exynos", "external/libdrm"],
    cflags: ["-Wall", "-Wextra", "-Werror", "-std=c11"],
}
