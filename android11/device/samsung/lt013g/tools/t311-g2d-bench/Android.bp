// Private Exynos G2D DMA benchmark; never in PRODUCT_PACKAGES.
cc_binary {
    name: "t311_g2d_bench_offline",
    vendor: true,
    srcs: ["main.c"],
    shared_libs: ["libdrm"],
    static_libs: ["libexynos_g2d_t311_offline"],
    include_dirs: ["external/libdrm/exynos", "external/libdrm"],
    cflags: ["-Wall", "-Wextra", "-Werror", "-std=c11", "-O2"],
}
