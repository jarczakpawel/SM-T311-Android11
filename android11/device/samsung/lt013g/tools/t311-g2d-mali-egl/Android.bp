// Offscreen G2D->real Mali EGL dma-buf import->GLES2 texture sample.
// ISOLATED: not installed into Android PRODUCT_PACKAGES/HWC.
cc_binary {
    name: "t311_g2d_mali_egl_offline",
    vendor: true,
    srcs: ["main.c", "g2d_bridge.c"],
    static_libs: ["libt311_minigbm_exynos_prime_offline", "libexynos_g2d_t311_offline"],
    shared_libs: ["libdrm", "libEGL", "libGLESv2", "libcutils", "libnativewindow", "libsync", "liblog"],
    include_dirs: ["external/minigbm", "external/libdrm/exynos", "external/libdrm", "device/samsung/lt013g/tools/t311-g2d-prime"],
    cflags: ["-Wall", "-Wextra", "-Werror", "-std=c11", "-O2"],
}
