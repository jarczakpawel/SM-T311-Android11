# Android 11 core-init action for the SM-T311 DWC2 ADB FunctionFS mount.
# Vendor domains cannot mount filesystem types under AOSP neverallow.
# Mount once in init context, then signal the legacy bootstrap helper.
on post-fs-data
    mkdir /dev/usb-ffs 0711 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    # G428: MTP/PTP userspace descriptors are provided by Android's MtpService
    # only after the owner selects file/photo transfer. No auto-USB switch.
    mkdir /dev/usb-ffs/mtp 0770 mtp mtp
    mkdir /dev/usb-ffs/ptp 0770 mtp mtp
    mount functionfs mtp /dev/usb-ffs/mtp rmode=0770,fmode=0660,uid=1024,gid=1024,no_disconnect=1
    mount functionfs ptp /dev/usb-ffs/ptp rmode=0770,fmode=0660,uid=1024,gid=1024,no_disconnect=1
    chmod 0711 /dev/usb-ffs
    setprop vendor.smt311.usb.bootstrap mount-ready
