# SM-T311 V168 Stage 2 — stable-kernel userspace performance.
# No cpuset, schedtune, bfqio or group UCLAMP.

on init
    mkdir /dev/cpuctl/background 0750 system system
    mkdir /dev/cpuctl/system-background 0750 system system
    mkdir /dev/cpuctl/foreground 0750 system system
    mkdir /dev/cpuctl/top-app 0750 system system
    mkdir /dev/cpuctl/rt 0750 system system
    mkdir /dev/cpuctl/camera-daemon 0750 system system
    mkdir /dev/blkio/background 0750 system system

    write /dev/cpuctl/background/cpu.shares 52
    write /dev/cpuctl/system-background/cpu.shares 256
    write /dev/cpuctl/foreground/cpu.shares 1024
    write /dev/cpuctl/top-app/cpu.shares 2048
    write /dev/cpuctl/rt/cpu.shares 2048
    write /dev/cpuctl/camera-daemon/cpu.shares 1024

on boot
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor schedutil
    write /sys/class/devfreq/13000000.gpu/governor simple_ondemand
    write /sys/class/devfreq/bus-dmc/governor simple_ondemand
    write /sys/block/mmcblk0/queue/scheduler bfq
    write /sys/block/mmcblk0/queue/read_ahead_kb 256
    write /sys/block/mmcblk0/queue/nr_requests 128
